{
  "_comment": [
    "Hand-curated client wiring for the `vyomi mcp` server. Merged into cmd/vyomi/mcp_matrix.json by scripts/gen_mcp_matrix.py.",
    "Everything here is client-side knowledge that is NOT derivable from providers/*.py: which env vars real SDKs honor,",
    "which data planes need TLS (:9443 via caddy), and which backends are separate emulator containers.",
    "Primary sources: README.md 'Using your existing cloud SDKs', samples/java/cloud-probe/.../ProbeEnv.java,",
    "providers/azure_services.py (Service Bus REST-only), docker-compose.appliance.yml (host ports).",
    "Placeholders rendered by the Go server: {sim} = http://<host>:<sim_port>, {sim_hostport} = <host>:<sim_port>,",
    "{host} = <host>, {tls_hostport} = <host>:<tls_port>, {account} = Azure storage/cosmos account name."
  ],
  "clouds": {
    "aws": {
      "env": [
        {
          "name": "AWS_ENDPOINT_URL",
          "value": "{sim}",
          "note": "Honored by current AWS CLI v2 and SDKs; older SDKs need endpoint_url / endpointOverride in code."
        },
        {
          "name": "AWS_ACCESS_KEY_ID",
          "value": "test"
        },
        {
          "name": "AWS_SECRET_ACCESS_KEY",
          "value": "test"
        },
        {
          "name": "AWS_DEFAULT_REGION",
          "value": "us-east-1"
        },
        {
          "name": "AWS_REGION",
          "value": "us-east-1"
        },
        {
          "name": "AWS_PAGER",
          "value": "",
          "note": "Stops AWS CLI v2's pager swallowing short output."
        }
      ],
      "notes": [
        "One endpoint serves every AWS service: the simulator routes by SigV4 scope / X-Amz-Target / Query Action.",
        "S3 is path-style: set forcePathStyle=true (JS v3) or s3={'addressing_style':'path'} (boto3) if virtual-host addressing fails.",
        "SNS->SQS fan-out works natively (shared MessagingStore)."
      ],
      "terraform": "provider \"aws\" {\n  region                      = \"us-east-1\"\n  access_key                  = \"test\"\n  secret_key                  = \"test\"\n  skip_credentials_validation = true\n  skip_requesting_account_id  = true\n  skip_metadata_api_check     = true\n  s3_use_path_style           = true\n  endpoints {\n    s3       = \"{sim}\"\n    sqs      = \"{sim}\"\n    dynamodb = \"{sim}\"\n    lambda   = \"{sim}\"\n    iam      = \"{sim}\"\n    ec2      = \"{sim}\"\n    rds      = \"{sim}\"\n    kms      = \"{sim}\"\n    sns      = \"{sim}\"\n    secretsmanager = \"{sim}\"\n  }\n}"
    },
    "gcp": {
      "env": [
        {
          "name": "STORAGE_EMULATOR_HOST",
          "value": "{sim}",
          "note": "GCS rides the simulator endpoint."
        },
        {
          "name": "PUBSUB_EMULATOR_HOST",
          "value": "{host}:8085",
          "note": "Separate gRPC emulator container, NOT the simulator port."
        },
        {
          "name": "FIRESTORE_EMULATOR_HOST",
          "value": "{host}:8080",
          "note": "Separate gRPC emulator container, NOT the simulator port."
        },
        {
          "name": "GOOGLE_CLOUD_PROJECT",
          "value": "cloudlearn",
          "note": "Use your active space's project id if it differs."
        }
      ],
      "notes": [
        "On the Max tier (Multipass VM) replace the host with the VM IP for :8085/:8080 if localhost isn't bridged.",
        "Secret Manager and Cloud KMS have no Google emulator: use the REST/HttpJson transport against https://{tls_hostport} (caddy) and trust its certificate.",
        "gcloud command adapters are partial; prefer client libraries."
      ],
      "terraform": "provider \"google\" {\n  project                 = \"cloudlearn\"\n  region                  = \"us-central1\"\n  access_token            = \"vyomi-local\"\n  storage_custom_endpoint = \"{sim}/storage/v1/\"\n}",
      "terraform_note": "UNVERIFIED against Vyomi: custom_endpoint overrides per google service; confirm with a conformance run before relying on it."
    },
    "azure": {
      "env": [
        {
          "name": "AZURE_STORAGE_CONNECTION_STRING",
          "value": "DefaultEndpointsProtocol=http;AccountName={account};AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint={sim}/{account};QueueEndpoint=http://{account}.queue.localtest.me:{sim_port};",
          "note": "Well-known Azurite key; the simulator ignores SharedKey signatures. *.localtest.me resolves to 127.0.0.1."
        },
        {
          "name": "AZURE_STORAGE_ACCOUNT",
          "value": "{account}"
        },
        {
          "name": "AZURE_SUBSCRIPTION_ID",
          "value": "00000000-0000-0000-0000-cloudlearn01",
          "note": "The only subscription a space has; any other id returns SubscriptionNotFound."
        },
        {
          "name": "AZURE_RESOURCE_MANAGER_ENDPOINT",
          "value": "{sim}",
          "note": "Pass as the ARM base_url / $host / cloud.Configuration ResourceManager endpoint; any credential is accepted."
        },
        {
          "name": "AZURE_COSMOS_ENDPOINT",
          "value": "https://{tls_hostport}/azure-data/cosmos/{account}",
          "note": "Cosmos SDKs require TLS: goes through caddy :9443, trust its certificate."
        },
        {
          "name": "AZURE_COSMOS_KEY",
          "value": "C2y6yDjf5/R+ob0N8A7Cgv30VRDJIWEHLM+4QDU5DE2nQ9nDuVTqobD4b8mGGyPMbIZnqyMsEcaGQy67XIw/Jw=="
        },
        {
          "name": "AZURE_KEYVAULT_URL",
          "value": "https://cloudlearn.vault.localtest.me:{tls_port}",
          "note": "Key Vault SDKs require TLS and rebuild paths from the host, so use the host-based form."
        }
      ],
      "notes": [
        "Service Bus: the simulator speaks both the REST protocol ({sim}/azure-data/servicebus) and native AMQP 1.0 (the default transport of azure-servicebus / @azure/service-bus / azure-messaging-servicebus) on :5672 (plaintext) / :5671 (AMQPS, not yet TLS-wired — use plaintext for now).",
        "Blob requests share :9000 with S3; the simulator routes them by the x-ms-version header, so keep the account as the first path segment."
      ],
      "terraform": "",
      "terraform_note": "Vyomi's Terraform workflow (core/terraform_export.py) covers the aws and google providers only. Provision Azure resources with az CLI / the ARM SDKs pointed at {sim}."
    }
  },
  "scan": {
    "skip_dirs": [
      ".git",
      "node_modules",
      "vendor",
      ".venv",
      "venv",
      "env",
      "dist",
      "build",
      "target",
      "__pycache__",
      ".terraform",
      ".next",
      ".idea",
      ".vscode",
      "coverage"
    ],
    "extensions": [
      ".py",
      ".js",
      ".mjs",
      ".cjs",
      ".ts",
      ".tsx",
      ".jsx",
      ".go",
      ".java",
      ".kt",
      ".tf",
      ".txt",
      ".toml",
      ".json",
      ".xml",
      ".gradle",
      ".kts",
      ".mod",
      ".yml",
      ".yaml",
      ".env"
    ],
    "rules": [
      {
        "cloud": "aws",
        "lang": "python",
        "pattern": "boto3\\.(?:client|resource)\\(\\s*['\"]([a-z0-9-]+)['\"]"
      },
      {
        "cloud": "aws",
        "lang": "nodejs",
        "pattern": "@aws-sdk/client-([a-z0-9-]+)"
      },
      {
        "cloud": "aws",
        "lang": "java",
        "pattern": "software\\.amazon\\.awssdk\\.services\\.([a-z0-9]+)"
      },
      {
        "cloud": "aws",
        "lang": "go",
        "pattern": "github\\.com/aws/aws-sdk-go-v2/service/([a-z0-9]+)"
      },
      {
        "cloud": "aws",
        "lang": "terraform",
        "pattern": "resource\\s+\"aws_([a-z0-9]+)_"
      },
      {
        "cloud": "gcp",
        "lang": "python",
        "pattern": "google\\.cloud(?:\\.|\\s+import\\s+)([a-z_]+)"
      },
      {
        "cloud": "gcp",
        "lang": "python",
        "pattern": "\\bgoogle-cloud-([a-z-]+)"
      },
      {
        "cloud": "gcp",
        "lang": "nodejs",
        "pattern": "@google-cloud/([a-z-]+)"
      },
      {
        "cloud": "gcp",
        "lang": "go",
        "pattern": "cloud\\.google\\.com/go/([a-z]+)"
      },
      {
        "cloud": "gcp",
        "lang": "java",
        "pattern": "com\\.google\\.cloud\\.([a-z]+)"
      },
      {
        "cloud": "gcp",
        "lang": "terraform",
        "pattern": "resource\\s+\"google_([a-z0-9_]+)\""
      },
      {
        "cloud": "azure",
        "lang": "python",
        "pattern": "\\b(AsyncAzureOpenAI|AzureOpenAI|AzureChatOpenAI|AzureOpenAIEmbeddings)\\b"
      },
      {
        "cloud": "azure",
        "lang": "nodejs",
        "pattern": "\\b(AzureOpenAI|AzureChatOpenAI|AzureOpenAIEmbeddings)\\b"
      },
      {
        "cloud": "azure",
        "lang": "python",
        "pattern": "(?:^|\\s)(?:from|import)\\s+azure\\.([a-z_]+(?:\\.[a-z_]+)?)"
      },
      {
        "cloud": "azure",
        "lang": "python",
        "pattern": "\\bazure-(storage-blob|storage-queue|servicebus|cosmos|keyvault-[a-z]+|eventgrid|mgmt-[a-z]+)"
      },
      {
        "cloud": "azure",
        "lang": "nodejs",
        "pattern": "@azure/([a-z-]+)"
      },
      {
        "cloud": "azure",
        "lang": "java",
        "pattern": "com\\.azure\\.(messaging\\.servicebus|messaging\\.eventgrid|storage\\.blob|storage\\.queue|cosmos|security\\.keyvault|resourcemanager\\.[a-z]+)"
      },
      {
        "cloud": "azure",
        "lang": "go",
        "pattern": "github\\.com/Azure/azure-sdk-for-go/sdk/(messaging/azservicebus|storage/azblob|storage/azqueue|data/azcosmos|security/keyvault|resourcemanager/[a-z]+/arm[a-z]+)"
      },
      {
        "cloud": "azure",
        "lang": "terraform",
        "pattern": "resource\\s+\"azurerm_([a-z_]+?)(?:_[a-z]+)*\""
      }
    ],
    "already_wired": "(endpoint_url|endpointOverride|AWS_ENDPOINT_URL|forcePathStyle|STORAGE_EMULATOR_HOST|PUBSUB_EMULATOR_HOST|FIRESTORE_EMULATOR_HOST|apiEndpoint|BlobEndpoint=|localtest\\.me|localhost:9000|127\\.0\\.0\\.1:9000)",
