    "warnings": {
      "azure/servicebus": "Service Bus SDKs default to AMQP, which the simulator now speaks natively on :5672 (plaintext; :5671/AMQPS isn't TLS-wired yet). REST ({sim}/azure-data/servicebus) and Azure Storage Queues remain available too.",
      "azure/cosmos": "Cosmos SDKs require TLS: point them at https://{tls_hostport}/azure-data/cosmos/<account> and trust the caddy certificate.",
      "azure/keyvault": "Key Vault SDKs require TLS and host-based URLs: https://<vault>.vault.localtest.me:{tls_port}.",
      "gcp/secretmanager": "No Google emulator exists: use the REST/HttpJson transport against https://{tls_hostport}.",
      "gcp/kms": "No Google emulator exists: use the REST/HttpJson transport against https://{tls_hostport}.",
      "gcp/pubsub": "Pub/Sub is a separate emulator: set PUBSUB_EMULATOR_HOST={host}:8085 (not the simulator port).",
      "gcp/firestore": "Firestore is a separate emulator: set FIRESTORE_EMULATOR_HOST={host}:8080 (not the simulator port).",
      "azure/cognitiveservices": "Azure OpenAI in Vyomi is SIMULATED (deterministic, labelled output, no real model): AzureOpenAI(azure_endpoint={sim}/azure-data/openai/<account>, api_key=<account key>). Good for wiring and tests, not for judging model quality."
