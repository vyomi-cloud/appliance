  },
  "account-settings": {
    "route": "#/iam/account-settings"
  },
  "edit-password-policy": {
    "route": "#/iam/account-settings/edit-password-policy",
    "expand": [
      "text=Custom"
    ]
  },
  "assign-delegated-administrator": {
    "route": "#/iam/account-settings/assign-delegated-administrator"
