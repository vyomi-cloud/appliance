{
  "_doc": "ui-spec page id → v4 route. honest_page = the whole page is a declared 'Not simulated in Vyomi' gap (NOT USED for iam — no aws/iam entry in honest-allowlist.json). Unlisted spec pages count as missing.",
  "dashboard": {
    "route": "#/iam/dashboard",
    "fixtures": ["iam-user", "iam-role", "iam-policy", "iam-group"]
  },
  "users": {
    "route": "#/iam/users",
    "fixtures": ["iam-user"],
    "live": "live-user"
  },
  "user-detail": {
    "route": "#/iam/users/{live}",
    "live": "live-user"
  },
  "create-user": {
    "route": "#/iam/create-user",
    "expand": [
      "role=checkbox[name=\"Provide user access to the AWS Management Console - optional\"]",
      "role=radio[name=\"I want to create an IAM user\"]",
      "role=button[name=\"Next\"]",
      "role=radio[name=\"Attach policies directly\"]",
      "role=button[name=\"Next\"]"
    ]
  },
  "user-groups": {
    "route": "#/iam/groups",
    "fixtures": ["iam-group"],
    "live": "live-group"
  },
  "group-detail": {
    "route": "#/iam/groups/{live}",
    "live": "live-group"
  },
  "create-user-group": {
    "route": "#/iam/create-user-group"
  },
  "roles": {
    "route": "#/iam/roles",
    "fixtures": ["iam-role"],
    "live": "live-role"
  },
  "role-detail": {
    "route": "#/iam/roles/{live}",
    "live": "live-role"
  },
  "create-role": {
    "route": "#/iam/create-role",
    "expand": [
      "role=button[name=\"Next\"]",
      "role=button[name=\"Next\"]"
    ]
  },
  "policies": {
    "route": "#/iam/policies",
    "fixtures": ["iam-policy"],
    "live": "live-policy"
  },
  "policy-detail": {
    "route": "#/iam/policies/{live}",
    "live": "live-policy"
  },
  "create-policy": {
    "route": "#/iam/create-policy",
    "expand": [
      "role=button[name=\"Next\"]"
    ]
  },
  "create-access-key": {
    "route": "#/iam/users/uic-user/create-access-key",
    "fixtures": ["iam-user"],
    "vars": { "resource-name": "uic-user" },
    "expand": [
      "role=button[name=\"Next\"]",
      "role=button[name=\"Next\"]"
    ]
  },
  "security-credentials": {
    "route": "#/iam/security-credentials"
  },
  "identity-providers": {
    "route": "#/iam/identity-providers",
