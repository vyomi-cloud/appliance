    "route": "#/dns/uic-rg/{live}",
    "live": "live-zone",
    "expand": ["button:has-text(\"Record set\")"]
  },
  "dns-zone-activity-log": {
    "route": "#/dns/uic-rg/{live}/activitylog",
    "live": "live-activity"
  },
  "dns-zone-access-control-iam": {
    "route": "#/dns/uic-rg/uic-dns-zone.com/iam",
    "fixtures": ["az-dns-zone"],
    "vars": { "resource-name": "uic-dns-zone.com" }
  },
  "dns-zone-tags": {
    "route": "#/dns/uic-rg/uic-dns-zone.com/tags",
    "fixtures": ["az-dns-zone"],
    "vars": { "resource-name": "uic-dns-zone.com" }
  },
  "dns-zone-diagnose-and-solve-problems": {
    "route": "#/dns/uic-rg/uic-dns-zone.com/diagnose",
    "fixtures": ["az-dns-zone"],
    "vars": { "resource-name": "uic-dns-zone.com" }
  },
  "dns-zone-virtual-network-links": {
    "route": "#/dns/uic-rg/{live}/vnetlinks",
    "live": "live-vnetlink"
  },
  "dns-zone-locks": {
    "route": "#/dns/uic-rg/{live}/locks",
