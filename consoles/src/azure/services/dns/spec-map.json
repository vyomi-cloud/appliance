    "expand": ["button:has-text(\"Add\")"]
  },
  "dns-zone-export-template": {
    "route": "#/dns/uic-rg/uic-dns-zone.com/exporttemplate",
    "fixtures": ["az-dns-zone"],
    "vars": { "resource-name": "uic-dns-zone.com" }
  }
}
