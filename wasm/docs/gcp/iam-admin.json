ects.serviceAccounts.signBlob","out":{"keyId":"example","signedBlob":"example"},"p":[["name","path","string",1,"projects/vyomi-project/serviceAccounts/my-serviceAccount"]],"sdk":"projects.serviceAccounts|signBlob","u":"/v1/{+name}:signBlob"},{"d":"Signs a JWT using a service account's system-managed private key.","ex":"/v1/projects/vyomi-project/serviceAccounts/my-serviceAccount:signJwt","in":{"delegates":["example"],"payload":"example"},"m":"POST","n":"iamcredentials.projects.serviceAccounts.signJwt","out":{"keyId":"example","signedJwt":"example"},"p":[["name","path","string",1,"projects/vyomi-project/serviceAccounts/my-serviceAccount"]],"sdk":"projects.serviceAccounts|signJwt","u":"/v1/{+name}:signJwt"}],"root":"https://iamcredentials.googleapis.com/","servicePath":"","title":"IAM Service Account Credentials API","total":7,"unwired":["iamcredentials.locations.workforcePools.getAllowedLocations","iamcredentials.projects.locations.workloadIdentityPools.getAllowedLocations"],"version":"v1","wired":5},{"gcloud":"","id":"sts","ops":[],"root":"https://sts.googleapis.com/","servicePath":"","title":"Security Token Service API","total":1,"unwired":["sts.token"],"version":"v1","wired":0}],"category":"Management","cloud":"gcp","features":[{"a":[],"id":"gcp.iam-admin.project-iam-bindings","l":"full","t":"IAM policy bindings (Allow tab — grant/remove access)","x":[]},{"a":[],"id":"gcp.iam-admin.deny-policies","l":"full","t":"Deny policies","x":[]},{"a":[],"id":"gcp.iam-admin.recommendations-history","l":"limited","t":"Recommendations history","x":["Vyomi logs applied IAM policy changes (grants and removals) here; it does not run GCP's IAM Recommender to generate new suggestions on its own, so nothing appears until you grant or remove access."]},{"a":[],"id":"gcp.iam-admin.service-accounts","l":"full","t":"Service accounts (create, describe, list, delete)","x":[]},{"a":[],"id":"gcp.iam-admin.service-account-keys","l":"limited","t":"Service account keys","x":["Key creation, listing and deletion are real and stateful, but the private key material is synthetic — it cannot be used to authenticate against anything outside Vyomi."]},{"a":[],"id":"gcp.iam-admin.service-account-metrics-logs","l":"limited","t":"Service account Metrics tab","x":["Shows a real series derived from the credentials this service account actually issued (access tokens, ID tokens, signed blobs/JWTs via iamcredentials.googleapis.com) — total request count, a breakdown by method and a per-day series — not Cloud Monitoring's full request/error/latency metrics (Vyomi has no request-latency telemetry pipeline)."]},{"a":[],"id":"gcp.iam-admin.service-account-logs","l":"limited","t":"Service account Logs tab","x":["Shows the admin-activity events Vyomi itself records for this service account — key create/delete, enable/disable, display-name updates, and Principals-with-access grants/revokes — not GCP's full Cloud Audit Log trail (e.g. API calls made using the account's own credentials)."]},{"a":[],"id":"gcp.iam-admin.roles-predefined","l":"full","t":"Predefined roles catalog","x":[]},{"a":[],"id":"gcp.iam-admin.roles-custom","l":"full","t":"Custom roles (create, edit, delete)","x":[]},{"a":[],"id":"gcp.iam-admin.project-settings","l":"full","t":"Project settings (name, labels)","x":[]},{"a":[],"id":"gcp.iam-admin.tags","l":"full","t":"Tags (tag keys)","x":[]},{"a":[],"id":"gcp.iam-admin.audit-logs-config","l":"limited","t":"Data Access audit logs configuration","x":["Admin Read toggles for iam.googleapis.com are enforced: when enabled, reading service accounts, keys, custom roles or the project's IAM policy writes a real Cloud Logging entry (readable back via entries:list, e.g. the gcp-logs console); disabled writes none. Data Read / Data Write toggles are stored and returned but produce no entries for iam.googleapis.com — this service has no data-plane payload to audit (same as real GCP; mutations are Admin Activity, always written and not configurable). Toggles for every other listed service (storage, pubsub, …) are stored only — gating those services' own operations is outside this service's scope."]},{"a":[],"id":"gcp.iam-admin.organization-policies","l":"limited","t":"Organization policy constraints","x":["Two predefined boolean constraints are enforced for real on both substrates: constraints/iam.disableServiceAccountCreation blocks serviceAccounts.create, and constraints/iam.disableServiceAccountKeyCreation blocks serviceAccounts.keys.create, whenever a policy with rules[0].enforce=true exists on the project (create one from 'Enforce predefined constraint' on this page). Every other predefined or custom constraint is created, listed and deleted for real but not evaluated against calls."]},{"a":[],"id":"gcp.iam-admin.privileged-access-manager","l":"full","t":"Privileged Access Manager — Entitlements, Grants & Approve grants","x":[]},{"a":[],"id":"gcp.iam-admin.pam-audit-logs","l":"limited","t":"PAM Audit Logs","x":["Shows the grant lifecycle events (requested, approved, denied, activated, expired, revoked) Vyomi's PAM core records; it does not aggregate the full Cloud Audit Log trail for entitlement changes made outside PAM."]},{"a":[],"id":"gcp.iam-admin.pam-settings","l":"limited","t":"PAM Settings","x":["Notification channels and a 'require justification' default are stored per project and ENFORCED: when 'require justification' is on, grant requests submitted without one are rejected, and every grant lifecycle event (requested, activated, denied, revoked, expired) records which configured channels Vyomi would notify. Vyomi does not deliver a real email or Pub/Sub message to those channels."]},{"a":[],"id":"gcp.iam-admin.essential-contacts","l":"full","t":"Essential Contacts","x":[]},{"a":[],"id":"gcp.iam-admin.policy-troubleshooter","l":"full","t":"Policy Troubleshooter","x":[]},{"a":[],"id":"gcp.iam-admin.policy-analyzer","l":"limited","t":"Policy Analyzer","x":["Queries who has a given role on the project from the stored IAM policy. Vyomi does not run full Cloud Asset Inventory analysis (inherited org/folder policy, resource-level IAM across products)."]},{"a":[],"id":"gcp.iam-admin.workload-identity-federation","l":"limited","t":"Workload Identity Federation — pool creation","x":["Creating and listing a workload identity pool is real and stateful. Connecting an external OIDC/SAML identity provider and exchanging its tokens for Google credentials is not modeled."]},{"a":[],"id":"gcp.iam-admin.workforce-identity-federation","l":"limited","t":"Workforce Identity Federation","x":["Every Vyomi project has a real backing organization (core/gcp_resourcemanager_core.py's default organization); creating, listing and deleting a workforce pool under it is real and stateful. Connecting an external OIDC/SAML workforce identity provider and exchanging its tokens for Google credentials is not modeled (same limitation as the project-scoped Workload Identity Federation pools)."]},{"a":[],"id":"gcp.iam-admin.groups","l":"limited","t":"Groups","x":["Cloud Identity group create/get/list/delete and membership add/list/remove, under the project's real backing organization, are real and stateful. Google Workspace/Cloud Identity directory sync, group-based Gmail/Calendar resources and dynamic group membership rules are not modeled."]},{"a":[],"id":"gcp.iam-admin.principal-access-boundary","l":"limited","t":"Principal Access Boundary","x":["Policies and bindings, under the project's real backing organization, are real and stateful, and ENFORCED: core/gcp_iam_core.py's testIamPermissions narrows a bound principal's access to only the resources named in its boundary's rules, even when a normal Allow-policy binding would otherwise grant more. Resource-type boundaries (vs. exact resource names) and the Boundary conditions CEL language aren't evaluated."]},{"a":[],"id":"gcp.iam-admin.managed-workload-identities","l":"limited","t":"Managed Workload Identities","x":["Managed identities nested under a workload identity pool are real and stateful — create, list, delete and certificate rotation all work, each issuing a new certificate record (serial number, notBefore/notAfter) on rotation. The certificate material is synthetic (not issued by a real CA), so it cannot be used to authenticate against anything outside Vyomi, and automatic background rotation on expiry is not modeled — rotation is explicit (same caveat as service-account keys)."]},{"a":[],"id":"gcp.iam-admin.asset-inventory","l":"limited","t":"Asset Inventory","x":["searchAllResources indexes what Vyomi's IAM & Resource Manager cores actually model for this project — service accounts, custom roles, workload identity pools, the project itself, its folders and tag keys — live, from current state, and supports the real search query language: field:value / field=value / comparison operators, AND / OR / NOT / '-' negation, parentheses, wildcards, quoted values, labels.<key>, plus assetTypes (wildcards), orderBy and pageSize / pageToken. It does not index resources from other GCP services (storage buckets, Pub/Sub topics, …), has no analyzeIamPolicy / BigQuery-SQL queryAssets, and keeps no change-history feed."]},{"a":[],"id":"gcp.iam-admin.security-insights","l":"limited","t":"Security Insights","x":["A small set of real IAM-lint rules are evaluated live against the project's actual policy bindings, service-account keys and issued credentials on every call (basic-role grants, service accounts with user-managed keys, service accounts that have never issued a credential and have no keys) — not GCP's full IAM Recommender rule catalog, and findings aren't persisted or tracked for dismissal across calls."]},{"a":[],"id":"gcp.iam-admin.quotas-system-limits","l":"limited","t":"Quotas & System Limits","x":["Shows real current usage (service accounts, their keys, custom roles, workload identity pools, organization policy constraints) against GCP's documented default per-project limits. Request-rate quotas (e.g. IAM API requests per minute) aren't shown — Vyomi doesn't meter API traffic — and limits are reference values only: Vyomi does not enforce them, so creating past a shown limit still succeeds."]},{"a":[],"id":"gcp.iam-admin.identity-organization","l":"limited","t":"Identity & Organization","x":["Shows the project's real backing organization (display name, directory customer ID, state) via Resource Manager's project.parent -> organization lookup. Claiming domain ownership via a DNS TXT record and signing up for Google Workspace/Cloud Identity (the real console's setup flow when a project has no organization yet) aren't modeled — every Vyomi project already has one."]},{"a":[],"id":"gcp.iam-admin.privacy-security","l":"limited","t":"Privacy & Security","x":["Data residency, CMEK count and the Access Transparency-style log are derived from live project state and Admin Activity audit entries. There are no cloud-provider staff in a simulator, so Access Approval is not applicable and the log lists privileged control-plane access by project principals. Project-scoped (no organization-level view)."]},{"a":[],"id":"gcp.iam-admin.identity-aware-proxy","l":"limited","t":"Identity-Aware Proxy","x":["Per-resource IAP enable/disable and its IAM policy (roles/iap.httpsResourceAccessor) are real and stateful, and the Allow decision is ENFORCED: a checkAccess call returns the same allow/deny IAP's own proxy would — denied while IAP is off, denied without the accessor role, allowed with it. Vyomi does not run an actual HTTPS reverse proxy in front of a real backend service/App Engine app; checkAccess is the decision, not a live request path."]},{"a":["policies.simulate"],"id":"gcp.iam-admin.org-policy-simulation","l":"limited","t":"Constraint simulation against existing resources","x":["Simulates four constraints Vyomi can evaluate against real state (service account key/account creation, uniform bucket-level access, public access prevention) using a Vyomi-specific policies:simulate verb; the real org-level Policy Simulator, custom constraints and list constraints are not simulated. Simulation never applies the change."]},{"a":["workloadIdentityPools.providers.create","workloadIdentityPools.providers.get","workloadIdentityPools.providers.list","workloadIdentityPools.providers.patch","workloadIdentityPools.providers.delete","sts.token","sts.introspect"],"id":"gcp.iam-admin.workload-identity-providers","l":"limited","t":"Workload identity pool providers (OIDC / SAML / AWS), attribute mapping and condition","x":["Providers are validated and the attribute mapping (assertion.* paths, string concatenation, lowerAscii) and CEL condition subset are evaluated for real during the STS token exchange (/v1/token). OIDC RS256 tokens are verified against the JWKS you paste into the provider, because Vyomi cannot fetch the issuer's JWKS URL; AWS and SAML providers are stored and validated but cannot exchange tokens. The minted federated token is not accepted by other Vyomi services' authorization, and service-account impersonation from it is not simulated."]},{"a":["workforcePools.providers.create","workforcePools.providers.get","workforcePools.providers.list","workforcePools.providers.delete"],"id":"gcp.iam-admin.workforce-identity-providers","l":"limited","t":"Workforce identity pool providers (OIDC / SAML)","x":["Providers are validated and stored with their attribute mapping and condition; workforce sign-in (browser SSO flow and console access) is not simulated. OIDC tokens can be exchanged at /v1/token with the same JWKS-paste limitation as workload identity federation."]}],"id":"iam-admin","ops":49,"registry_unreachable":[["gcp.iam-admin.org-policy-simulation","policies.simulate"],["gcp.iam-admin.workload-identity-providers","workloadIdentityPools.providers.create"],["gcp.iam-admin.workload-identity-providers","workloadIdentityPools.providers.get"],["gcp.iam-admin.workload-identity-providers","workloadIdentityPools.providers.list"],["gcp.iam-admin.workload-identity-providers","workloadIdentityPools.providers.patch"],["gcp.iam-admin.workload-identity-providers","workloadIdentityPools.providers.delete"],["gcp.iam-admin.workload-identity-providers","sts.token"],["gcp.iam-admin.workload-identity-providers","sts.introspect"],["gcp.iam-admin.workforce-identity-providers","workforcePools.providers.create"],["gcp.iam-admin.workforce-identity-providers","workforcePools.providers.get"],["gcp.iam-admin.workforce-identity-providers","workforcePools.providers.list"],["gcp.iam-admin.workforce-identity-providers","workforcePools.providers.delete"]],"title":"IAM & Admin","total":141}
