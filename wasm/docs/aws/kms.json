lgorithm":"HMAC_SHA_224","Message":"ZXhhbXBsZQ=="},"m":"POST","n":"VerifyMac","out":{"KeyId":"my-key-id","MacAlgorithm":"HMAC_SHA_224","MacValid":true},"p":[["KeyId","string",1],["Mac","blob",1],["MacAlgorithm","string",1],["Message","blob",1],["DryRun","boolean",0],["GrantTokens","list",0]],"py":"verify_mac","t":"TrentService.VerifyMac","u":"/"}],"protocol":"json","py_client":"kms","signing":"kms","style":"JSON-RPC (X-Amz-Target)","target":"TrentService","title":"AWS Key Management Service","total":54,"unwired":["CreateGrant","DeleteImportedKeyMaterial","DeriveSharedSecret","GenerateDataKeyPair","GenerateDataKeyPairWithoutPlaintext","GetKeyLastUsage","GetParametersForImport","GetPublicKey","ImportKeyMaterial","ListGrants","ListRetirableGrants","ReEncrypt","ReplicateKey","RetireGrant","RevokeGrant","UpdatePrimaryRegion"],"version":"2014-11-01","wired":38}],"category":"Security, Identity, & Compliance","cloud":"aws","features":[{"a":[],"id":"kms.key.crud","l":"full","t":"Keys (create, describe, list)","x":[]},{"a":[],"id":"kms.key.lifecycle","l":"full","t":"Key state (enable, disable, schedule/cancel deletion)","x":[]},{"a":[],"id":"kms.key.policy","l":"limited","t":"Key policy","x":["The key policy document is stored and returned exactly as written, but Vyomi does not evaluate it — it never denies or allows a KMS call based on policy content."]},{"a":[],"id":"kms.key.tags","l":"full","t":"Tags","x":[]},{"a":[],"id":"kms.key.rotation","l":"full","t":"Key rotation (automatic flag + on-demand)","x":["Automatic rotation really fires: Vyomi has no background scheduler, so EnableKeyRotation's period is checked lazily (on the next operation against the key, or the next GetKeyRotationStatus/DescribeKey/ListKeyRotations call) rather than on a running clock, exactly how DynamoDB TTL and Secrets Manager rotation are evaluated here — but the backing key material does genuinely rotate on schedule, not just get recorded. Ciphertext from before any rotation keeps decrypting, exactly like AWS."]},{"a":[],"id":"kms.key.aliases","l":"full","t":"Aliases","x":[]},{"a":[],"id":"kms.crypto.symmetric","l":"full","t":"Encrypt / Decrypt / GenerateDataKey / GenerateRandom","x":[]},{"a":[],"id":"kms.crypto.asymmetric","l":"limited","t":"Sign / Verify, GenerateMac / VerifyMac, Encapsulate / Decapsulate","x":["Signatures, MACs and ML-KEM shared secrets are produced with Vyomi's own authenticated primitive (the same construction as Encrypt/Decrypt), not real RSA/ECC/ML-DSA math or ML-KEM lattice math. They are genuine, tamper-detected and key-separated, but only verifiable inside Vyomi — not with a real public key outside it."]},{"a":[],"id":"kms.aws-managed-keys","l":"full","t":"AWS managed keys (aws/<service>)","x":[]},{"a":[],"id":"kms.key-administrators","l":"full","t":"Key administrators / key users / other AWS accounts pickers","x":[]},{"a":[],"id":"kms.custom-key-stores","l":"limited","t":"Custom key stores (AWS CloudHSM / external key stores)","x":["Creating, listing, updating and deleting a custom key store record is real and stateful. Connecting one is not: Vyomi has no real CloudHSM cluster or external XKS proxy to reach, so ConnectCustomKeyStore always ends in a FAILED connection state, same as AWS would report without reachable backing infrastructure. No key's material is ever stored in a custom key store."]},{"a":[],"id":"kms.custom-key-store-keys","l":"not_simulated","t":"Keys backed by a custom key store (CloudHSM / external)","x":["Creating a key with CloudHSM or external key store origin needs a CONNECTED custom key store; the CloudHSM cluster / external key manager proxy does not exist in Vyomi, so ConnectCustomKeyStore always ends FAILED."]}],"id":"kms","ops":38,"registry_unreachable":[],"title":"Key Management Service","total":54}
