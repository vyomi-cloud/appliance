"stage":"SUPPORTED"
},
"source.repos.create":{
"stage":"SUPPORTED"
},
"source.repos.delete":{
"stage":"SUPPORTED"
},
"source.repos.get":{
"stage":"SUPPORTED"
},
"source.repos.getIamPolicy":{
"stage":"SUPPORTED"
},
"source.repos.getProjectConfig":{
"stage":"SUPPORTED"
},
"source.repos.list":{
"stage":"SUPPORTED"
},
