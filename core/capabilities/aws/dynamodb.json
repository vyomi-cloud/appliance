{
 "$doc": "Vyomi capability registry \u2014 DynamoDB. See s3.json for the contract.",
 "dynamodb.table.crud": {
  "title": "Tables (create, describe, list, delete)",
  "level": {
   "nano": "full",
   "offline": "full"
  },
  "limitations": [],
  "api": [
   "CreateTable",
   "DescribeTable",
   "ListTables",
   "DeleteTable"
  ],
  "probe": {
   "ddb_ok": [
    "ListTables",
    "DescribeTable"
   ]
  },
  "tests": [
   "tests/conformance/test_dynamodb_core.py"
  ]
 },
 "dynamodb.item.crud": {
  "title": "Items (put, get, update, delete, query, scan, batch, transactions)",
  "level": {
   "nano": "full",
   "offline": "full"
  },
  "limitations": [],
  "probe": {
   "ddb_ok": [
    "Query",
    "Scan",
    "BatchWriteItem",
    "TransactWriteItems"
   ]
  },
  "tests": [
   "tests/conformance/test_dynamodb_core.py"
  ]
 },
