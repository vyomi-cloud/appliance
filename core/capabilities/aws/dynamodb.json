{
 "$doc": "Vyomi capability registry \u2014 DynamoDB. See s3.json for the contract.",
 "dynamodb.table.crud": {
  "title": "Tables (create, describe, list, delete)",
  "level": {
   "nano": "full",
   "offline": "full"
  },
  "limitations": [],
  "api": [
   "CreateTable",
   "DescribeTable",
   "ListTables",
   "DeleteTable"
  ],
  "probe": {
   "ddb_ok": [
    "ListTables",
    "DescribeTable"
   ]
  },
  "tests": [
   "tests/conformance/test_dynamodb_core.py"
  ]
 },
 "dynamodb.item.crud": {
  "title": "Items (put, get, update, delete, query, scan, batch, transactions)",
  "level": {
   "nano": "full",
   "offline": "full"
  },
  "limitations": [],
  "probe": {
   "ddb_ok": [
    "Query",
    "Scan",
    "BatchWriteItem",
    "TransactWriteItems"
   ]
  },
  "tests": [
   "tests/conformance/test_dynamodb_core.py"
  ]
 },
 "dynamodb.table.indexes": {
  "title": "Global secondary indexes",
  "level": {
   "nano": "full",
   "offline": "full"
  },
  "limitations": [],
  "tests": [
   "tests/conformance/test_dynamodb_gsi_core.py"
  ]
 },
 "dynamodb.table.settings": {
  "title": "Table class, deletion protection, encryption (at create)",
  "level": {
   "nano": "limited",
   "offline": "limited"
  },
  "limitations": [
   "Deletion protection is enforced (DeleteTable is rejected while it is on).",
   "Table class and encryption at rest are stored and returned but have no effect; data is not encrypted at rest."
  ],
  "tests": [
   "tests/conformance/test_dynamodb_table_ops_core.py",
   "tests/conformance/test_dynamodb_table_settings_core.py"
  ]
 },
 "dynamodb.table.tags": {
  "title": "Tags",
  "level": {
   "nano": "full",
   "offline": "full"
  },
  "limitations": [],
  "probe": {
   "ddb_ok": [
    "TagResource",
    "ListTagsOfResource"
   ]
  }
 },
 "dynamodb.table.update": {
  "title": "Update capacity / settings (UpdateTable)",
  "level": {
   "nano": "limited",
   "offline": "limited"
  },
  "limitations": [
   "Provisioned capacity is recorded but not enforced \u2014 Vyomi never throttles requests."
  ],
  "tests": [
   "tests/conformance/test_dynamodb_table_ops_core.py"
  ]
 },
 "dynamodb.table.ttl": {
  "title": "Time to Live (TTL)",
  "level": {
   "nano": "limited",
   "offline": "limited"
  },
  "limitations": [
   "Expired items are removed when they are read, queried or scanned \u2014 not by a background process within ~48 hours as in AWS."
  ],
  "tests": [
   "tests/conformance/test_dynamodb_table_ops_core.py"
  ]
 },
 "dynamodb.table.pitr": {
  "title": "Point-in-time recovery (PITR)",
  "level": {
   "nano": "limited",
   "offline": "limited"
  },
  "limitations": [
   "PITR can be turned on and reports its restore window; RestoreTableToPointInTime is not implemented yet \u2014 use on-demand backups to restore."
  ],
  "tests": [
   "tests/conformance/test_dynamodb_table_ops_core.py"
  ]
 },
 "dynamodb.backups": {
  "title": "On-demand backups",
  "level": {
   "nano": "full",
   "offline": "full"
  },
  "limitations": [],
