{
  "name": "Vyomi Sandbox — AWS (full)",
  "//": "S3 · DynamoDB · SQS · SNS · IAM · KMS · Secrets Manager · RDS · EC2. Shares ../boot.sh + ../docker-compose.sandbox.yml.",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": { "moby": true, "version": "latest" },
    "ghcr.io/devcontainers/features/sshd:1": {}
  },
  "forwardPorts": [9000],
  "portsAttributes": { "9000": { "label": "Vyomi Console", "onAutoForward": "openBrowser" } },
  "//postCreate": "Keep provisioning fast (no CLI features that build during Provisioning). boot.sh installs the SDK/CLIs in the background so they don't block.",
  "postCreateCommand": "bash .devcontainer/boot.sh up",
  "postStartCommand": "bash .devcontainer/boot.sh heartbeat",
  "containerEnv": { "COMPOSE_PROFILES": "aws", "VYOMI_PROFILE": "aws-full" },
  "remoteEnv": { "VYOMI_SANDBOX_TTL": "8h", "VYOMI_LICENSE_BACKEND_URL": "https://vyomi.cloud", "VYOMI_BILLING": "free_personal_quota" },
  "hostRequirements": { "cpus": 4, "memory": "8gb", "storage": "32gb" }
}
