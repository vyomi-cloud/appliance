# syntax=docker/dockerfile:1.7
# Vyomi booster all-languages runtime (64-bit, linux/amd64 + linux/arm64).
# Every pinned version + checksum comes from versions.json (generated by
# scripts/refresh_versions.py).  Build with ./build.sh (it feeds the 3 ARGs below).
ARG PYTHON_IMAGE=python:3.15.2-slim-trixie
ARG RUBY_IMAGE=ruby:4.0.9-slim-trixie
ARG PHP_IMAGE=php:8.5.12-cli-trixie

FROM ${PYTHON_IMAGE} AS py
FROM ${RUBY_IMAGE} AS rb
FROM ${PHP_IMAGE} AS php

FROM debian:trixie-slim AS base
ARG TARGETARCH
ENV DEBIAN_FRONTEND=noninteractive LANG=C.UTF-8
# L1: OS packages + C/C++ (gcc/g++/clang) + runtime libs needed by the copied python/ruby/php
RUN apt-get update && apt-get install -y --no-install-recommends \
      ca-certificates curl git jq unzip xz-utils bzip2 make cmake pkg-config \
      gcc g++ clang libc6-dev libssl-dev libffi-dev zlib1g-dev \
      libssl3t64 libffi8 libyaml-0-2 libgmp10 libreadline8t64 libncursesw6 libsqlite3-0 \
      libbz2-1.0 liblzma5 libuuid1 libexpat1 libgdbm6t64 libargon2-1 libsodium23 libxml2 \
      libonig5 libcurl4t64 libzstd1 \
 && rm -rf /var/lib/apt/lists/* /var/cache/apt/*

# L2: Temurin JDKs (LTS + latest) - checksum-verified, trimmed
RUN --mount=type=bind,source=versions.json,target=/v.json \
    set -eux; for k in lts latest; do \
      m=$(jq -r ".java.$k.major" /v.json); u=$(jq -r ".java.$k.url.$TARGETARCH" /v.json); s=$(jq -r ".java.$k.sha256.$TARGETARCH" /v.json); \
      curl -fsSL -o /tmp/j.tgz "$u"; echo "$s  /tmp/j.tgz" | sha256sum -c -; \
      mkdir -p /opt/java/$m; tar -xzf /tmp/j.tgz -C /opt/java/$m --strip-components=1; rm /tmp/j.tgz; \
      rm -rf /opt/java/$m/jmods /opt/java/$m/lib/src.zip /opt/java/$m/sample /opt/java/$m/man; \
    done; ln -s /opt/java/$(jq -r .java.lts.major /v.json) /opt/java/lts; ln -s /opt/java/$(jq -r .java.latest.major /v.json) /opt/java/latest; \
    ln -s /opt/java/lts /opt/java/current

# L3: .NET SDK (sha512)
RUN --mount=type=bind,source=versions.json,target=/v.json \
    set -eux; u=$(jq -r ".dotnet.url.$TARGETARCH" /v.json); s=$(jq -r ".dotnet.sha512.$TARGETARCH" /v.json); \
    curl -fsSL -o /tmp/d.tgz "$u"; echo "$s  /tmp/d.tgz" | sha512sum -c -; \
    mkdir -p /opt/dotnet; tar -xzf /tmp/d.tgz -C /opt/dotnet; rm /tmp/d.tgz

# L4: Go
RUN --mount=type=bind,source=versions.json,target=/v.json \
    set -eux; v=$(jq -r .go.version /v.json); s=$(jq -r ".go.sha256.$TARGETARCH" /v.json); \
    curl -fsSL -o /tmp/g.tgz "https://go.dev/dl/go$v.linux-$TARGETARCH.tar.gz"; echo "$s  /tmp/g.tgz" | sha256sum -c -; \
    tar -xzf /tmp/g.tgz -C /opt; rm -rf /tmp/g.tgz /opt/go/test /opt/go/doc /opt/go/misc

# L5: Rust (rustc + cargo + std only; no docs)
RUN --mount=type=bind,source=versions.json,target=/v.json \
    set -eux; u=$(jq -r ".rust.url.$TARGETARCH" /v.json); s=$(jq -r ".rust.sha256.$TARGETARCH" /v.json); \
    case $TARGETARCH in amd64) T=x86_64;; arm64) T=aarch64;; esac; \
    curl -fsSL -o /tmp/r.txz "$u"; echo "$s  /tmp/r.txz" | sha256sum -c -; \
    mkdir /tmp/r && tar -xJf /tmp/r.txz -C /tmp/r --strip-components=1; \
    /tmp/r/install.sh --prefix=/opt/rust --components=rustc,cargo,rust-std-$T-unknown-linux-gnu --disable-ldconfig; rm -rf /tmp/r /tmp/r.txz

# L6: Node (LTS) + corepack-free pnpm/yarn via npm, Maven, Gradle
RUN --mount=type=bind,source=versions.json,target=/v.json \
    set -eux; v=v$(jq -r .node.version /v.json); s=$(jq -r ".node.sha256.$TARGETARCH" /v.json); A=$([ $TARGETARCH = amd64 ] && echo x64 || echo arm64); \
    curl -fsSL -o /tmp/n.txz "https://nodejs.org/dist/$v/node-$v-linux-$A.tar.xz"; echo "$s  /tmp/n.txz" | sha256sum -c -; \
    mkdir -p /opt/node; tar -xJf /tmp/n.txz -C /opt/node --strip-components=1; rm -rf /tmp/n.txz /opt/node/share/doc /opt/node/share/man /opt/node/include; \
    mv=$(jq -r .package_managers.maven.version /v.json); ms=$(jq -r .package_managers.maven.sha512 /v.json); \
    curl -fsSL -o /tmp/m.tgz "https://repo1.maven.org/maven2/org/apache/maven/apache-maven/$mv/apache-maven-$mv-bin.tar.gz"; echo "$ms  /tmp/m.tgz" | sha512sum -c -; \
    mkdir -p /opt/maven; tar -xzf /tmp/m.tgz -C /opt/maven --strip-components=1; rm /tmp/m.tgz; \
    gv=$(jq -r .package_managers.gradle.version /v.json); gs=$(jq -r .package_managers.gradle.sha256 /v.json); \
    curl -fsSL -o /tmp/g.zip "https://services.gradle.org/distributions/gradle-$gv-bin.zip"; echo "$gs  /tmp/g.zip" | sha256sum -c -; \
    unzip -q /tmp/g.zip -d /opt && mv /opt/gradle-$gv /opt/gradle; rm /tmp/g.zip

# L7: python / ruby / php from the official docker-library images (same Debian base)
COPY --from=py  /usr/local/ /usr/local/
COPY --from=rb  /usr/local/ /usr/local/
COPY --from=php /usr/local/ /usr/local/

ENV JAVA_HOME=/opt/java/current DOTNET_ROOT=/opt/dotnet GOROOT=/opt/go GOPATH=/home/booster/go \
    CARGO_HOME=/home/booster/.cargo DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1 \
    DOTNET_SYSTEM_GLOBALIZATION_INVARIANT=1 NPM_CONFIG_PREFIX=/home/booster/.npm-global \
    PATH=/home/booster/.npm-global/bin:/home/booster/.cargo/bin:/home/booster/go/bin:/opt/java/current/bin:/opt/dotnet:/opt/go/bin:/opt/rust/bin:/opt/node/bin:/opt/maven/bin:/opt/gradle/bin:/usr/local/bin:/usr/local/sbin:/usr/sbin:/usr/bin:/sbin:/bin
ENV LD_LIBRARY_PATH=/opt/rust/lib

# L8: package-manager pins (pip, pnpm, yarn classic, composer) + non-root user
RUN --mount=type=bind,source=versions.json,target=/v.json \
    set -eux; pip install --no-cache-dir --break-system-packages "pip==$(jq -r .package_managers.pip /v.json)" 2>&1 | tail -1; \
    npm i -g --prefix /opt/node "npm@$(jq -r .package_managers.npm /v.json)" "pnpm@$(jq -r .package_managers.pnpm /v.json)" "yarn@$(jq -r .package_managers.yarn_classic /v.json)" && npm cache clean --force; \
    curl -fsSL -o /usr/local/bin/composer "https://getcomposer.org/download/$(jq -r .package_managers.composer.version /v.json)/composer.phar"; \
    echo "$(jq -r .package_managers.composer.sha256 /v.json)  /usr/local/bin/composer" | sha256sum -c -; chmod +x /usr/local/bin/composer; \
    useradd -m -u 1000 -s /bin/bash booster; mkdir -p /work && chown booster /work
COPY versions.json /etc/booster-lang-versions.json
USER booster
WORKDIR /work
CMD ["bash"]
