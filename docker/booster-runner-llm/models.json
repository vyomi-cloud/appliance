{
  "_comment": "Runner model catalogue (spike): TEN models on 10 hosted-runner slots (8 runners; qwen3:30b is a POOLED entry occupying 2 slots). EAGER but STAGGERED: stage 0 (3B+embed, 7B) is dispatched at booster start, stage N is dispatched N x 30 s later (VYOMI_RUNNER_STAGGER_S); the console shows each model 'starting' until its runner(s) are ready. Ten models far exceed the 10 GB-per-repo Actions cache, so most runners COLD-PULL from registry.ollama.ai at every start and rotation (a few minutes each; ollama verifies blob sha256 against the manifest). ram_mb = weights + KV at the stated ctx (ESTIMATES, unmeasured). Ollama tags were NOT verified against the registry in the spike (closest documented library tags used; qwen3:30b is the 30B-A3B MoE, ~19 GB Q4: needs 2 runners).",
  "default_chat": "qwen2.5-3b",
  "default_embed": "nomic-embed-text",
  "runners": {
    "fast":    {"role": "fast chat + embeddings",        "stage": 0, "models": ["qwen2.5-3b", "nomic-embed-text"]},
    "general": {"role": "general instruct",              "stage": 0, "models": ["qwen2.5-7b"]},
    "coder":   {"role": "code",                          "stage": 1, "models": ["qwen2.5-coder-7b"]},
    "agents":  {"role": "tool use / agents",             "stage": 1, "models": ["llama3.1-8b"]},
    "gemma":   {"role": "general / multilingual",        "stage": 1, "models": ["gemma2-9b"]},
    "qwen3":   {"role": "reasoning + tools (hybrid)",    "stage": 2, "models": ["qwen3-8b"]},
    "r1":      {"role": "reasoning (chain of thought)",  "stage": 2, "models": ["deepseek-r1-8b"]},
    "mistral": {"role": "general (European lab)",        "stage": 2, "models": ["mistral-7b"]},
    "big":     {"role": "largest: 30B MoE, pooled over 2 runners", "stage": 3, "slots": 2, "models": ["qwen3-30b"]}
  },
  "models": {
