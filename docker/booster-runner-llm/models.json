    "llama3.1-8b":      {"kind": "chat",  "ollama": "llama3.1:8b-instruct-q4_K_M",       "size_mb": 4900,  "ram_mb": 6800,  "ctx": 8192, "note": "tool use / agents"},
    "gemma2-9b":        {"kind": "chat",  "ollama": "gemma2:9b-instruct-q4_K_M",         "size_mb": 5800,  "ram_mb": 7800,  "ctx": 8192, "note": "no native tool calling"},
    "qwen3-8b":         {"kind": "chat",  "ollama": "qwen3:8b",                           "size_mb": 5200,  "ram_mb": 7000,  "ctx": 8192, "note": "thinking / non-thinking, tool use"},
    "deepseek-r1-8b":   {"kind": "chat",  "ollama": "deepseek-r1:8b",                     "size_mb": 5200,  "ram_mb": 7000,  "ctx": 8192, "note": "emits <think> reasoning; slow first answer"},
    "mistral-7b":       {"kind": "chat",  "ollama": "mistral:7b-instruct-q4_K_M",        "size_mb": 4400,  "ram_mb": 6000,  "ctx": 8192, "note": "general"},
    "qwen3-30b":        {"kind": "chat",  "ollama": "qwen3:30b",                          "size_mb": 19000, "ram_mb": 24000, "ctx": 4096, "pooled": true, "note": "30B-A3B MoE, ~19 GB Q4 does not fit one 16 GB runner: split across 2 runners via llama.cpp RPC over the WireGuard mesh (PLACEHOLDER transport until v4/ngmesh merges); ~3B active params so decode is usable"}
