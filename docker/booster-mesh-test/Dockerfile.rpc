# LOCAL TEST image (vyomi-mesh-llama:test): adds the llama.cpp RPC backend to the stock server image WITHOUT recompiling llama.cpp.
# The stock ghcr.io/ggml-org/llama.cpp:server has the --rpc flag but ships no RPC backend and no rpc-server. ggml backends are
# dynamically loaded (libggml-cpu-*.so sit next to llama-server), so we build ONLY libggml-rpc.so + rpc-server from the SAME commit
# as the stock binary (b12124 / 8bed7cfb9: client and servers must match) and drop them into /app. Build takes a few minutes, not an hour.
FROM vyomi-mesh-node:test AS build
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake git ca-certificates && rm -rf /var/lib/apt/lists/*
ARG LLAMA_COMMIT=8bed7cfb9
RUN mkdir /src && cd /src && git init -q && git remote add origin https://github.com/ggml-org/llama.cpp \
 && git fetch -q --depth 1 origin ${LLAMA_COMMIT} && git checkout -q FETCH_HEAD \
 && cmake -B build -DGGML_RPC=ON -DGGML_BACKEND_DL=ON -DGGML_NATIVE=OFF -DLLAMA_CURL=OFF -DLLAMA_BUILD_TESTS=OFF -DLLAMA_BUILD_EXAMPLES=OFF -DLLAMA_BUILD_SERVER=OFF -DCMAKE_BUILD_TYPE=Release \
 && cmake --build build -j4 --target ggml-rpc rpc-server \
 && mkdir -p /opt/llama && cp build/bin/rpc-server /opt/llama/ && cp -a build/bin/libggml*.so* /opt/llama/ && ls -la /opt/llama

FROM vyomi-mesh-node:test
COPY --from=build /opt/llama/rpc-server /app/rpc-server
COPY --from=build /opt/llama/libggml-rpc.so /app/libggml-rpc.so
COPY --from=build /opt/llama/libggml-base.so.* /opt/llama-rpc-libs/
ENV LD_LIBRARY_PATH=/app:/opt/llama-rpc-libs
