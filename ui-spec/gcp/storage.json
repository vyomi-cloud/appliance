      "id": "create-bucket",
      "kind": "create",
      "title": "Create a bucket",
      "route": "/storage/create-bucket",
      "breadcrumbs": [
        "Cloud Storage",
        "Buckets",
        "Create a bucket"
      ],
      "captures": [
        "C-forms/01-storage-create-bucket/step-1",
        "A-storage/001-L1-landing",
        "A-storage/033-L3-create"
      ],
      "provenance": "reference",
