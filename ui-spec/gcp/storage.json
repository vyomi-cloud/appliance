      "notes": "Capture shows only 'Sign up for the free trial' (billing gate). Vertical stepper; each step has Continue.",
      "submit": "Create",
      "steps": [
        {
          "title": "Get started",
          "sections": [
            {
              "title": "Name your bucket",
              "fields": [
                {
                  "label": "Name",
                  "type": "text",
                  "required": true,
                  "help": "Pick a globally unique, permanent name",
                  "constraints": "3-63 characters: lowercase letters, numbers, dashes, underscores, dots"
                },
                {
                  "label": "Labels (optional)",
                  "type": "tags",
                  "actions": [
                    "Add label"
                  ]
                },
                {
                  "label": "Tags (optional)",
                  "type": "tags",
                  "confidence": "low"
                }
              ]
            }
          ]
        },
        {
          "title": "Choose where to store your data",
          "sections": [
            {
              "title": "Location type",
              "fields": [
                {
                  "label": "Location type",
                  "type": "radio",
                  "required": true,
                  "default": "Multi-region",
                  "options": [
                    "Multi-region",
                    "Dual-region",
                    "Region"
                  ]
                },
                {
                  "label": "Location",
                  "type": "select",
                  "required": true,
                  "default": "us (multiple regions in United States)",
                  "help": "Multi-region: us, eu, asia; Region: e.g. us-central1 (Iowa)"
                },
                {
                  "label": "Add turbo replication",
                  "type": "checkbox",
                  "default": false,
                  "visible_when": "Location type = Dual-region",
                  "confidence": "low"
                }
              ]
            }
          ]
        },
        {
          "title": "Choose how to store your data",
          "sections": [
            {
              "title": "Set a default class",
              "fields": [
                {
                  "label": "Storage class",
                  "type": "radio",
                  "default": "Set a default class",
                  "options": [
                    "Set a default class",
                    "Autoclass"
                  ]
                },
                {
                  "label": "Default storage class",
                  "type": "radio",
                  "default": "Standard",
                  "options": [
                    "Standard",
                    "Nearline",
                    "Coldline",
                    "Archive"
                  ],
                  "visible_when": "Set a default class"
                }
              ]
            },
            {
              "title": "Optimize storage for data-intensive workloads",
              "fields": [
                {
                  "label": "Enable hierarchical namespace on this bucket",
                  "type": "checkbox",
                  "default": false
                }
              ],
              "confidence": "medium"
            }
          ]
        },
        {
          "title": "Choose how to control access to objects",
          "sections": [
            {
              "title": "Prevent public access",
              "fields": [
                {
                  "label": "Enforce public access prevention on this bucket",
                  "type": "checkbox",
                  "default": true
                }
              ]
            },
            {
              "title": "Access control",
              "fields": [
                {
                  "label": "Access control",
                  "type": "radio",
                  "default": "Uniform",
                  "options": [
                    "Uniform",
                    "Fine-grained"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Choose how to protect object data",
          "sections": [
            {
              "title": "Data protection",
              "fields": [
                {
                  "label": "Soft delete policy (For data recovery)",
                  "type": "checkbox",
                  "default": true,
                  "children": [
                    {
                      "label": "Retention duration",
                      "type": "number",
                      "default": 7
                    },
                    {
                      "label": "Unit",
                      "type": "select",
                      "default": "days",
                      "options": [
                        "days"
                      ],
                      "confidence": "low"
                    }
                  ]
                },
                {
                  "label": "Object versioning (For version control)",
                  "type": "checkbox",
                  "default": false
                },
                {
                  "label": "Retention (For compliance)",
                  "type": "checkbox",
                  "default": false,
                  "children": [
                    {
                      "label": "Set bucket retention policy",
                      "type": "checkbox"
                    },
                    {
                      "label": "Enable object retention",
                      "type": "checkbox"
                    }
                  ]
                }
              ]
            },
            {
              "title": "Data encryption",
              "fields": [
                {
                  "label": "Data encryption",
                  "type": "radio",
                  "default": "Google-managed encryption key",
                  "options": [
                    "Google-managed encryption key",
                    "Cloud KMS key"
                  ]
                }
              ],
              "confidence": "medium"
            }
          ]
        }
      ]
