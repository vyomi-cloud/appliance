    {
      "id": "create-instance",
      "kind": "create",
      "title": "Create a Redis instance",
      "route": "/memorystore/redis/instances/create",
      "provenance": "reference",
      "confidence": "medium",
      "submit": "Create instance",
      "sections": [
        {
          "title": "Instance info",
          "fields": [
            {
              "label": "Instance ID",
              "type": "text",
              "required": true,
              "constraints": "Lowercase letters, numbers, hyphens; start with a letter; up to 40 characters"
            },
            {
              "label": "Display name",
              "type": "text"
            },
            {
              "label": "Tier",
              "type": "radio",
              "required": true,
              "default": "Basic",
              "options": [
                "Basic",
                "Standard (high availability)"
              ],
              "help": "Standard adds a replica and automatic failover across zones."
            },
            {
              "label": "Redis version",
              "type": "select",
              "default": "Redis 7.0",
              "options": [
                "Redis 7.2",
                "Redis 7.0",
                "Redis 6.x",
                "Redis 5.0",
                "Redis 4.0",
                "Redis 3.2"
              ]
            }
          ]
        },
        {
          "title": "Capacity",
          "fields": [
            {
              "label": "Capacity (GB)",
              "type": "number",
              "required": true,
              "default": 1,
              "constraints": "1-300 GB",
              "help": "Memory size per node. Approximate node count and estimated monthly cost update as you change this."
            }
          ]
        },
        {
          "title": "Region and zone",
          "fields": [
            {
              "label": "Region",
              "type": "select",
              "required": true,
              "default": "us-central1 (Iowa)"
            },
            {
              "label": "Zone",
              "type": "select",
              "default": "Any"
            },
            {
              "label": "Alternative zone",
              "type": "select",
              "help": "Zone for the replica; must differ from Zone."
            }
          ]
        },
        {
          "title": "Configure instance connection",
          "expandable": true,
          "fields": [
            {
              "label": "Network",
              "type": "select",
              "default": "default",
              "help": "VPC network the instance is reachable from (authorizedNetwork)."
            },
            {
              "label": "Connection mode",
              "type": "radio",
              "default": "Direct peering",
              "options": [
                "Direct peering",
                "Private services access"
              ]
            },
            {
              "label": "Reserved IP range",
              "type": "text",
              "placeholder": "10.0.0.0/29",
              "help": "CIDR block reserved for the instance; auto-allocated if left blank."
            },
            {
              "label": "Enable AUTH",
              "type": "checkbox",
              "default": false,
              "help": "Require an AUTH string to connect."
            },
            {
              "label": "In-transit encryption",
              "type": "checkbox",
              "default": false,
              "help": "Enforce TLS (server authentication) between clients and the instance."
            }
          ]
        },
        {
          "title": "Read replicas (Standard tier only)",
          "expandable": true,
          "fields": [
            {
              "label": "Read replicas",
              "type": "radio",
              "default": "Disabled",
              "options": [
                "Disabled",
                "Enabled"
              ]
            },
            {
              "label": "Number of replicas",
              "type": "number",
              "default": 1,
              "constraints": "1-5"
            }
          ]
        },
        {
          "title": "Data persistence",
          "expandable": true,
          "fields": [
            {
              "label": "Persistence mode",
              "type": "radio",
              "default": "Disabled",
              "options": [
                "Disabled",
                "RDB snapshot"
              ]
            },
            {
              "label": "Snapshot period",
              "type": "select",
              "default": "Every 24 hours",
              "options": [
                "Every 1 hour",
                "Every 6 hours",
                "Every 12 hours",
                "Every 24 hours"
              ]
            }
          ]
        },
        {
          "title": "Redis configuration",
          "expandable": true,
          "fields": [
            {
              "label": "maxmemory-policy",
              "type": "select",
              "default": "volatile-lru",
              "options": [
                "volatile-lru",
                "allkeys-lru",
                "volatile-lfu",
                "allkeys-lfu",
                "volatile-random",
                "allkeys-random",
                "volatile-ttl",
                "noeviction"
              ]
            },
            {
              "label": "Additional parameters",
              "type": "table",
              "columns": [
                "Parameter",
                "Value"
              ],
              "actions": [
                "Add a parameter"
              ],
              "help": "notify-keyspace-events, activedefrag, timeout, slowlog-*, stream-node-max-* and others the engine supports."
            }
          ]
        },
        {
          "title": "Maintenance window",
          "expandable": true,
          "fields": [
            {
              "label": "Day",
              "type": "select",
              "default": "No preference"
            },
            {
              "label": "Start time",
              "type": "select"
            }
          ]
        },
        {
          "title": "Labels",
          "fields": [
            {
              "label": "Labels",
              "type": "tags",
              "actions": [
                "Add label"
              ]
            }
          ]
        }
      ]
