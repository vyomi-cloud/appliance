      "provenance": "capture",
      "confidence": "high",
      "submit": "Create",
      "notes": "Reached from /functions/add: Cloud Run create service with the Function source preselected.",
      "sections": [
        {
          "title": "Source",
          "fields": [
            {
              "label": "Deployment source",
              "type": "radio",
              "default": "Function",
              "options": [
                "Deploy one revision from an existing container image",
                "Continuously deploy from a repository (source or function)",
                "Use an inline editor to create a function"
              ]
            }
          ]
        },
        {
          "title": "Function",
          "fields": [
            {
              "label": "Runtime",
              "type": "select",
              "required": true,
              "default": "Node.js 22",
              "options": [
                "Node.js 22",
                "Python 3.13",
                "Go 1.24",
                "Java 21",
                ".NET 8",
                "Ruby 3.4",
                "PHP 8.4"
              ],
              "help": "Use an inline editor to create a function"
            },
            {
              "label": "Trigger (optional)",
              "type": "button",
              "actions": [
                "Add trigger"
              ]
            }
          ]
        },
        {
          "title": "Configure",
          "fields": [
            {
              "label": "Service name",
              "type": "text",
              "required": true
            },
            {
              "label": "Region",
              "type": "select",
              "required": true,
              "default": "us-central1 (Iowa)"
            },
            {
              "label": "Custom URLs",
              "type": "button",
              "actions": [
                "Add a custom URL"
              ]
            },
            {
              "label": "Endpoint URL",
              "type": "readonly"
            }
          ]
        },
        {
          "title": "Authentication",
          "fields": [
            {
              "label": "Authentication",
              "type": "radio",
              "required": true,
              "options": [
                "Allow public access",
                "Require authentication"
              ],
              "help": "Require authentication: select between IAM and/or Identity-Aware Proxy (IAP)"
            }
          ]
        },
        {
          "title": "Billing",
          "fields": [
            {
              "label": "Billing",
              "type": "radio",
              "default": "Request-based",
              "options": [
                "Request-based",
                "Instance-based"
              ]
            }
          ]
        },
        {
          "title": "Service scaling",
          "fields": [
            {
              "label": "Service scaling",
              "type": "radio",
              "default": "Auto scaling",
              "options": [
                "Auto scaling",
                "Manual scaling"
              ]
            },
            {
              "label": "Minimum number of instances",
              "type": "number",
              "default": 0,
              "help": "Set to 1 to reduce cold starts."
            },
            {
              "label": "Maximum number of instances",
              "type": "number"
            },
            {
              "label": "Customize autoscaling factors",
              "type": "checkbox",
              "default": false
            }
          ]
        },
        {
          "title": "Ingress",
          "fields": [
            {
              "label": "Ingress",
              "type": "radio",
              "default": "All",
              "options": [
                "Internal",
                "All"
              ]
