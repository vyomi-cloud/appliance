    {
      "id": "create-function",
      "kind": "create",
      "title": "Create service",
      "route": "/run/create",
      "captures": [
        "C-forms/07-functions-add/step-1",
        "C-forms/07-functions-add/step-1--tab-02-networking",
        "C-forms/07-functions-add/step-1--tab-03-security"
