            {
              "label": "Allow traffic from external Application Load Balancers",
              "type": "checkbox",
              "visible_when": "Ingress = Internal"
            }
          ]
        },
        {
          "title": "Containers, Networking, Security",
          "fields": [
            {
              "label": "Containers",
              "type": "other",
