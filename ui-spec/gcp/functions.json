                  "type": "text",
                  "help": "Leave blank to use the entry point command defined in the container image."
                },
                {
                  "label": "Container arguments",
                  "type": "text",
                  "help": "Arguments passed to the entry point command."
                },
                {
                  "label": "Memory",
                  "type": "select",
                  "default": "512 MiB"
                },
                {
                  "label": "CPU",
                  "type": "select",
                  "default": "1"
                },
                {
                  "label": "Ephemeral disk",
                  "type": "checkbox"
                },
                {
                  "label": "GPU",
                  "type": "checkbox"
                },
                {
                  "label": "Health checks",
                  "type": "button",
                  "actions": [
                    "Add health check"
                  ]
                },
                {
                  "label": "Variables & Secrets",
                  "type": "table",
                  "columns": [
                    "Name",
                    "Value"
                  ],
                  "actions": [
                    "Add variable",
                    "Reference a secret"
                  ],
                  "provenance": "reference",
                  "confidence": "medium"
                },
                {
                  "label": "Volumes",
                  "type": "table",
                  "actions": [
                    "Add volume"
                  ],
                  "provenance": "reference",
                  "confidence": "medium"
                },
                {
                  "label": "Request timeout",
                  "type": "number",
                  "default": 300,
                  "help": "seconds (maximum 3600)"
                },
                {
                  "label": "Maximum concurrent requests per instance",
                  "type": "number",
                  "default": 80
                },
                {
                  "label": "Execution environment",
                  "type": "radio",
                  "default": "Default",
                  "options": [
                    "Default",
                    "First generation",
                    "Second generation"
                  ]
                },
                {
                  "label": "Revision scaling",
                  "type": "other"
                },
                {
                  "label": "Startup CPU boost",
                  "type": "checkbox",
                  "default": true
                },
                {
                  "label": "Cloud SQL connections",
                  "type": "button",
                  "actions": [
                    "Add connection"
                  ]
                }
              ],
              "actions": [
                "Add Container"
              ]
            },
            {
              "label": "Networking",
              "type": "other",
              "children": [
                {
                  "label": "Use HTTP/2 end-to-end",
                  "type": "checkbox"
                },
                {
                  "label": "Session affinity",
                  "type": "checkbox"
                },
                {
                  "label": "Connect to a VPC for outbound traffic",
                  "type": "checkbox"
                },
                {
                  "label": "Join a Service Mesh.",
                  "type": "checkbox"
                }
              ]
            },
            {
              "label": "Security",
              "type": "other",
              "children": [
                {
                  "label": "Service account",
                  "type": "select",
                  "default": "Default compute service account"
                },
                {
                  "label": "Verify container deployment with Binary Authorization",
                  "type": "checkbox"
                },
                {
                  "label": "Encryption",
                  "type": "radio",
                  "default": "Google-managed encryption key",
                  "options": [
                    "Google-managed encryption key",
                    "Cloud KMS key"
                  ]
                }
              ]
            }
          ],
          "expandable": true
        }
