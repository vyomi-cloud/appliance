          "fields": [
            {
              "label": "Database version",
              "type": "select",
              "required": true,
              "default": "PostgreSQL 17",
              "options": [
                "PostgreSQL 17",
                "PostgreSQL 16",
                "PostgreSQL 15",
                "PostgreSQL 14",
                "MySQL 8.4",
                "MySQL 8.0",
                "MySQL 5.7"
