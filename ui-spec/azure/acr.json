    {
      "id": "create-container-registry",
      "kind": "create",
      "title": "Create container registry",
      "route": "#create/Microsoft.ContainerRegistry",
      "breadcrumbs": [
        "Home",
        "Container registries",
        "Create container registry"
      ],
      "captures": [
        "C-forms/12-create-microsoft-containerregistry/step-1"
      ],
      "provenance": "reference",
      "confidence": "medium",
      "steps": [
        {
          "title": "Basics",
          "sections": [
            {
              "title": "Project details",
              "fields": [
                {
                  "label": "Subscription",
                  "type": "select",
                  "required": true,
                  "placeholder": "Select a subscription"
                },
                {
                  "label": "Resource group",
                  "type": "select",
                  "required": true,
                  "actions": [
                    "Create new"
                  ]
                }
              ]
            },
            {
              "title": "Instance details",
              "fields": [
                {
                  "label": "Registry name",
                  "type": "text",
                  "required": true,
                  "constraints": ".azurecr.io; 5-50 alphanumeric characters"
                },
                {
                  "label": "Location",
                  "type": "select",
                  "required": true,
                  "default": "East US"
                },
                {
                  "label": "Use availability zones",
                  "type": "checkbox",
                  "default": false
                },
                {
                  "label": "Pricing plan",
                  "type": "select",
                  "required": true,
                  "default": "Standard",
                  "options": [
                    "Basic",
                    "Standard",
                    "Premium"
                  ]
                },
                {
                  "label": "Domain name label scope",
                  "type": "select",
                  "default": "Unsecure",
                  "options": [
                    "Unsecure",
                    "Tenant Reuse",
                    "Subscription Reuse",
                    "Resource Group Reuse",
                    "No Reuse"
                  ]
                },
                {
                  "label": "Role assignment permissions mode",
                  "type": "select",
                  "default": "RBAC Registry Permissions",
                  "options": [
                    "RBAC Registry Permissions",
                    "RBAC Registry + ABAC Repository Permissions"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Networking",
          "sections": [
            {
              "title": "Network connectivity",
              "fields": [
                {
                  "label": "Connectivity",
                  "type": "radio",
                  "default": "Public access",
                  "options": [
                    "Public access",
                    "Private access"
                  ],
                  "help": "Private access requires Premium"
                }
              ]
            }
          ]
        },
        {
          "title": "Encryption",
          "sections": [
            {
              "title": "Encryption",
              "fields": [
                {
                  "label": "Customer-managed key",
                  "type": "radio",
                  "default": "Disabled",
                  "options": [
                    "Enabled",
                    "Disabled"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Tags",
          "sections": [
            {
              "title": "Tags",
              "fields": [
                {
                  "label": "Tags",
                  "type": "table",
                  "columns": [
                    "Name",
                    "Value",
                    "Resource"
                  ],
                  "help": "Name/value pairs to categorize resources and view consolidated billing"
                }
              ]
            }
          ]
        },
        {
          "title": "Review + create",
          "sections": [
