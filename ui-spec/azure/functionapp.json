    {
      "id": "create-function-app",
      "kind": "create",
      "title": "Create Function App (Flex Consumption)",
      "route": "#create/Microsoft.FunctionApp",
      "breadcrumbs": [
        "Home",
        "Function App",
        "Create Function App"
      ],
      "captures": [
        "C-forms/07-create-microsoft-functionapp/step-1"
      ],
      "provenance": "reference",
      "confidence": "medium",
      "steps": [
        {
          "title": "Basics",
          "sections": [
            {
              "title": "Project details",
              "fields": [
                {
                  "label": "Subscription",
                  "type": "select",
                  "required": true,
                  "placeholder": "Select a subscription"
                },
                {
                  "label": "Resource Group",
                  "type": "select",
                  "required": true,
                  "actions": [
                    "Create new"
                  ]
                }
              ]
            },
            {
              "title": "Instance Details",
              "fields": [
                {
                  "label": "Function App name",
                  "type": "text",
                  "required": true,
                  "constraints": ".azurewebsites.net"
                },
                {
                  "label": "Secure unique default hostname on.",
                  "type": "toggle",
                  "default": true
                },
                {
                  "label": "Runtime stack",
                  "type": "select",
                  "required": true,
                  "options": [
                    ".NET",
                    "Java",
                    "Node.js",
                    "PowerShell Core",
                    "Python",
                    "Custom Handler"
                  ]
                },
                {
                  "label": "Version",
                  "type": "select",
                  "required": true
                },
                {
                  "label": "Region",
                  "type": "select",
                  "required": true,
                  "default": "East US"
                }
              ]
            },
            {
              "title": "Zone redundancy",
              "fields": [
                {
                  "label": "Zone redundancy",
                  "type": "radio",
                  "default": "Disabled",
                  "options": [
                    "Enabled",
                    "Disabled"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Storage",
          "sections": [
            {
              "title": "Storage",
              "fields": [
                {
                  "label": "Storage account",
                  "type": "select",
                  "required": true,
                  "actions": [
                    "Create new"
                  ]
                },
                {
                  "label": "Diagnostic Settings",
                  "type": "radio",
                  "options": [
                    "Don't configure diagnostic settings now",
                    "Configure diagnostic settings now"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Azure OpenAI",
          "sections": [
            {
              "title": "Azure OpenAI",
              "fields": [
                {
                  "label": "Enable Azure OpenAI",
                  "type": "checkbox",
                  "default": false
                }
              ]
            }
          ],
          "optional": true
        },
        {
          "title": "Networking",
          "sections": [
            {
              "title": "Networking",
              "fields": [
                {
                  "label": "Enable public access",
                  "type": "toggle",
                  "default": true
                },
                {
                  "label": "Enable virtual network integration",
                  "type": "toggle",
                  "default": false
                }
              ]
            }
          ]
        },
        {
          "title": "Monitoring",
          "sections": [
            {
              "title": "Application Insights",
              "fields": [
                {
                  "label": "Enable Application Insights",
                  "type": "radio",
                  "default": "Yes",
                  "options": [
                    "Yes",
                    "No"
                  ]
                },
                {
                  "label": "Application Insights",
                  "type": "select",
                  "actions": [
                    "Create new"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Deployment",
          "sections": [
            {
              "title": "GitHub Actions settings",
              "fields": [
                {
                  "label": "Continuous deployment",
                  "type": "radio",
                  "default": "Disable",
                  "options": [
                    "Disable",
                    "Enable"
                  ]
                }
              ]
            },
            {
              "title": "Authentication settings",
              "fields": [
                {
                  "label": "Basic authentication",
                  "type": "radio",
                  "default": "Disable",
                  "options": [
                    "Disable",
                    "Enable"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Authentication",
          "sections": [
            {
              "title": "Authentication settings",
              "fields": [
                {
                  "label": "Authentication type",
                  "type": "radio",
                  "options": [
                    "Secrets",
                    "Managed identity"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Tags",
          "sections": [
            {
              "title": "Tags",
              "fields": [
                {
                  "label": "Tags",
                  "type": "table",
                  "columns": [
                    "Name",
                    "Value",
                    "Resource"
                  ],
                  "help": "Name/value pairs to categorize resources and view consolidated billing"
                }
              ]
            }
          ]
        },
        {
          "title": "Review + create",
          "sections": [
            {
              "title": "Details"
            },
            {
              "title": "Instance Details"
            },
            {
              "title": "Storage"
            },
            {
              "title": "Monitoring"
            },
            {
              "title": "Deployment"
            }
          ]
        }
      ],
      "submit": "Create",
      "notes": "Footer: Review + create / < Previous / Next : <tab> >; Download a template for automation"
    },
