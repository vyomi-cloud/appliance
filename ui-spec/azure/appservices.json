    {
      "id": "create-web-app",
      "kind": "create",
      "title": "Create Web App",
      "route": "#create/Microsoft.WebSite",
      "breadcrumbs": [
        "Home",
        "App Services",
        "Create Web App"
      ],
      "captures": [
        "C-forms/08-create-microsoft-website/step-1"
      ],
      "provenance": "reference",
      "confidence": "medium",
      "steps": [
        {
          "title": "Basics",
          "sections": [
            {
              "title": "Project details",
              "fields": [
                {
                  "label": "Subscription",
                  "type": "select",
                  "required": true,
                  "placeholder": "Select a subscription"
                },
                {
                  "label": "Resource Group",
                  "type": "select",
                  "required": true,
                  "actions": [
                    "Create new"
                  ]
                }
              ]
            },
            {
              "title": "Instance Details",
              "fields": [
                {
                  "label": "Name",
                  "type": "text",
                  "required": true,
                  "constraints": ".azurewebsites.net"
                },
                {
                  "label": "Secure unique default hostname on.",
                  "type": "toggle",
                  "default": true
                },
                {
                  "label": "Publish",
                  "type": "radio",
                  "default": "Code",
                  "options": [
                    "Code",
                    "Container"
                  ]
                },
                {
                  "label": "Runtime stack",
                  "type": "select",
                  "required": true,
                  "options": [
                    ".NET 9 (STS)",
                    ".NET 8 (LTS)",
                    "Java 21",
                    "Java 17",
                    "Node 22 LTS",
                    "Node 20 LTS",
                    "PHP 8.4",
                    "Python 3.13",
                    "Python 3.12"
                  ]
                },
                {
                  "label": "Operating System",
                  "type": "radio",
                  "default": "Linux",
                  "options": [
                    "Linux",
                    "Windows"
                  ]
                },
                {
                  "label": "Region",
                  "type": "select",
                  "required": true,
                  "default": "East US"
                }
              ]
            },
            {
              "title": "Pricing plans",
              "fields": [
                {
                  "label": "Linux Plan (East US)",
                  "type": "select",
                  "required": true,
                  "actions": [
                    "Create new"
                  ]
                },
                {
                  "label": "Pricing plan",
                  "type": "select",
                  "required": true,
                  "actions": [
                    "Explore pricing plans"
                  ]
                }
              ]
            },
            {
              "title": "Zone redundancy",
              "fields": [
                {
                  "label": "Zone redundancy",
                  "type": "radio",
                  "default": "Disabled",
                  "options": [
                    "Enabled",
                    "Disabled"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Database",
          "sections": [
            {
              "title": "Database",
              "fields": [
                {
                  "label": "Create a Database",
                  "type": "checkbox",
                  "default": false
                }
              ]
            }
          ],
          "optional": true
        },
        {
          "title": "Container",
          "sections": [
            {
              "title": "Image source",
              "fields": [
                {
                  "label": "Image Source",
                  "type": "select",
                  "options": [
                    "Quickstart",
                    "Azure Container Registry",
                    "Docker Hub or other registries"
                  ]
                }
              ]
            }
          ],
          "optional": true
        },
        {
          "title": "Deployment",
          "sections": [
            {
              "title": "GitHub Actions settings",
              "fields": [
                {
                  "label": "Continuous deployment",
                  "type": "radio",
                  "default": "Disable",
                  "options": [
                    "Disable",
                    "Enable"
                  ]
                }
              ]
            },
            {
              "title": "GitHub Actions details",
              "fields": [
                {
                  "label": "GitHub account",
                  "type": "other",
                  "actions": [
                    "Authorize"
                  ]
                },
                {
                  "label": "Organization",
                  "type": "select"
                },
                {
                  "label": "Repository",
                  "type": "select"
                },
                {
                  "label": "Branch",
                  "type": "select"
                }
              ]
            },
            {
              "title": "Authentication settings",
              "fields": [
                {
                  "label": "Basic authentication",
                  "type": "radio",
                  "default": "Disable",
                  "options": [
                    "Disable",
                    "Enable"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Networking",
          "sections": [
            {
              "title": "Networking",
              "fields": [
                {
                  "label": "Enable public access",
                  "type": "toggle",
                  "default": true
                },
                {
                  "label": "Enable network injection",
                  "type": "toggle",
                  "default": false
                }
              ]
            }
          ]
        },
        {
          "title": "Monitor + secure",
          "sections": [
            {
              "title": "Application Insights",
              "fields": [
                {
                  "label": "Enable Application Insights",
                  "type": "radio",
                  "default": "No",
                  "options": [
                    "Yes",
                    "No"
                  ]
                },
                {
                  "label": "Application Insights",
                  "type": "select",
                  "actions": [
                    "Create new"
                  ],
                  "visible_when": "Enable Application Insights = Yes"
                },
                {
                  "label": "Region",
                  "type": "readonly"
                }
              ]
            },
            {
              "title": "Microsoft Defender for App Service",
              "fields": [
                {
                  "label": "Enable Microsoft Defender for App Service",
                  "type": "checkbox"
                }
              ]
            }
          ]
        },
        {
          "title": "Tags",
          "sections": [
            {
              "title": "Tags",
              "fields": [
                {
                  "label": "Tags",
                  "type": "table",
                  "columns": [
                    "Name",
                    "Value",
                    "Resource"
                  ],
                  "help": "Name/value pairs to categorize resources and view consolidated billing"
                }
              ]
            }
          ]
        },
        {
          "title": "Review + create",
          "sections": [
            {
              "title": "Details"
            },
            {
              "title": "Instance Details"
            },
            {
              "title": "App Service Plan (New)"
            },
            {
              "title": "Monitor + secure"
            },
            {
              "title": "Deployment"
            }
          ]
        }
      ],
      "submit": "Create",
      "notes": "Footer: Review + create / < Previous / Next : <tab> >; Download a template for automation"
    },
