      "steps": [
        {
          "title": "Basics",
          "sections": [
            {
              "title": "Project Details",
              "fields": [
                {
                  "label": "Subscription",
                  "type": "select",
                  "required": true,
                  "placeholder": "Select a subscription"
                },
                {
                  "label": "Resource group",
                  "type": "select",
                  "required": true,
                  "actions": [
                    "Create new"
                  ]
                }
              ]
            },
            {
              "title": "Namespace details",
              "fields": [
                {
                  "label": "Namespace name",
                  "type": "text",
                  "required": true,
                  "constraints": ".servicebus.windows.net; 6-50 chars"
                },
                {
                  "label": "Location",
                  "type": "select",
                  "required": true,
                  "default": "East US"
                },
                {
                  "label": "Pricing tier",
                  "type": "select",
                  "required": true,
                  "default": "Standard",
                  "options": [
                    "Basic",
                    "Standard",
                    "Premium"
                  ]
                },
                {
                  "label": "Messaging units",
                  "type": "select",
                  "options": [
                    "1",
                    "2",
                    "4",
                    "8",
                    "16"
                  ],
                  "visible_when": "Pricing tier = Premium"
                },
                {
                  "label": "Partitions",
                  "type": "select",
                  "options": [
                    "1",
                    "2",
                    "4"
                  ],
                  "visible_when": "Pricing tier = Premium"
                }
              ]
            }
          ]
        },
        {
          "title": "Advanced",
          "sections": [
            {
              "title": "Advanced",
              "fields": [
                {
                  "label": "Minimum TLS version",
                  "type": "radio",
                  "default": "1.2",
                  "options": [
                    "1.0",
                    "1.1",
                    "1.2"
                  ]
                },
                {
                  "label": "Local Authentication",
                  "type": "radio",
                  "default": "Enabled",
                  "options": [
                    "Enabled",
                    "Disabled"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Networking",
          "sections": [
            {
              "title": "Network connectivity",
              "fields": [
                {
                  "label": "Connectivity method",
                  "type": "radio",
