    {
      "id": "create-api-management-service",
      "kind": "create",
      "title": "Create API Management service",
      "route": "#create/Microsoft.ApiManagement",
      "breadcrumbs": [
        "Home",
        "API Management services",
        "Create API Management service"
      ],
      "captures": [
        "C-forms/14-create-microsoft-apimanagement/step-1"
      ],
      "provenance": "reference",
      "confidence": "medium",
      "steps": [
        {
          "title": "Basics",
          "sections": [
            {
              "title": "Project details",
              "fields": [
                {
                  "label": "Subscription",
                  "type": "select",
                  "required": true,
                  "placeholder": "Select a subscription"
                },
                {
                  "label": "Resource group",
                  "type": "select",
                  "required": true,
                  "actions": [
                    "Create new"
                  ]
                }
              ]
            },
            {
              "title": "Instance details",
              "fields": [
                {
                  "label": "Region",
                  "type": "select",
                  "required": true,
                  "default": "(US) East US"
                },
                {
                  "label": "Resource name",
                  "type": "text",
                  "required": true,
                  "constraints": ".azure-api.net"
                },
                {
                  "label": "Organization name",
                  "type": "text",
                  "required": true
                },
                {
                  "label": "Administrator email",
                  "type": "text",
                  "required": true
                }
              ]
            },
            {
              "title": "Pricing tier",
              "fields": [
                {
                  "label": "Pricing tier",
                  "type": "select",
                  "required": true,
                  "default": "Developer (no SLA)",
                  "options": [
                    "Basic v2",
                    "Standard v2",
                    "Premium v2",
                    "Developer (no SLA)",
                    "Basic",
                    "Standard",
                    "Premium",
                    "Consumption"
                  ]
                },
                {
                  "label": "Units",
                  "type": "number",
                  "default": 1
                }
              ]
            }
          ]
        },
        {
          "title": "Monitor + secure",
          "sections": [
            {
              "title": "Monitor + secure",
              "fields": [
                {
                  "label": "Log Analytics",
                  "type": "checkbox"
                },
                {
                  "label": "Application Insights",
                  "type": "checkbox"
                },
                {
                  "label": "Defender for APIs",
                  "type": "checkbox"
                }
              ]
            }
          ]
        },
        {
          "title": "Virtual network",
          "sections": [
            {
              "title": "Network connectivity",
              "fields": [
                {
                  "label": "Connectivity type",
                  "type": "radio",
                  "default": "None",
                  "options": [
                    "None",
                    "Virtual network",
                    "Private endpoint"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Managed identity",
          "sections": [
            {
              "title": "System assigned managed identity",
              "fields": [
                {
                  "label": "Status",
                  "type": "checkbox",
                  "default": false
                }
              ]
            }
          ]
        },
        {
          "title": "Protocol settings",
          "sections": [
            {
              "title": "Client side",
              "fields": [
                {
                  "label": "Client side protocols and ciphers",
                  "type": "table",
                  "columns": [
                    "Protocol",
                    "Enabled"
                  ]
                }
              ]
            },
            {
              "title": "Backend side",
              "fields": [
                {
                  "label": "Backend side protocols and ciphers",
                  "type": "table",
                  "columns": [
                    "Protocol",
                    "Enabled"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Tags",
          "sections": [
            {
              "title": "Tags",
              "fields": [
                {
                  "label": "Tags",
                  "type": "table",
                  "columns": [
                    "Name",
                    "Value",
                    "Resource"
                  ],
                  "help": "Name/value pairs to categorize resources and view consolidated billing"
                }
              ]
            }
          ]
        },
        {
          "title": "Review + install",
          "sections": [
            {
              "title": "Basics"
            },
            {
              "title": "Monitor + secure"
            },
            {
              "title": "Virtual network"
            },
            {
              "title": "Managed identity"
            },
            {
              "title": "Tags"
            }
          ]
        }
      ],
      "submit": "Create",
      "notes": "Last tab is 'Review + install'; Pricing tier options vary by region"
    },
