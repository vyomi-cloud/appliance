    {
      "id": "create-event-grid-topic",
      "kind": "create",
      "title": "Create Topic",
      "route": "#create/Microsoft.EventGridTopic",
      "breadcrumbs": [
        "Home",
        "Event Grid Topics",
        "Create Topic"
      ],
      "captures": [
        "C-forms/15-create-microsoft-eventgridtopic/step-1"
      ],
      "provenance": "reference",
      "confidence": "medium",
      "steps": [
        {
          "title": "Basics",
          "sections": [
            {
              "title": "Project details",
              "fields": [
                {
                  "label": "Subscription",
                  "type": "select",
                  "required": true,
                  "placeholder": "Select a subscription"
                },
                {
                  "label": "Resource group",
                  "type": "select",
                  "required": true,
                  "actions": [
                    "Create new"
                  ]
                }
              ]
            },
            {
              "title": "Topic Details",
              "fields": [
                {
                  "label": "Name",
                  "type": "text",
                  "required": true
                },
                {
                  "label": "Region",
                  "type": "select",
                  "required": true,
                  "default": "(US) East US"
                }
              ]
            }
          ]
        },
        {
          "title": "Networking",
          "sections": [
            {
              "title": "Network connectivity",
              "fields": [
                {
                  "label": "Connectivity method",
                  "type": "radio",
                  "default": "Public access",
                  "options": [
                    "Public access",
                    "Private access"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Security",
          "sections": [
            {
              "title": "Managed identity",
              "fields": [
                {
                  "label": "Managed identity type",
                  "type": "select",
                  "default": "None",
                  "options": [
                    "None",
                    "System assigned",
                    "User assigned"
                  ]
                }
              ]
            },
            {
              "title": "Access keys",
              "fields": [
                {
                  "label": "Enable access keys and Shared Access Signatures (SAS)",
                  "type": "checkbox",
                  "default": true
                }
              ]
            },
            {
              "title": "Minimum TLS version",
              "fields": [
                {
                  "label": "Minimum TLS version",
                  "type": "select",
                  "default": "1.2",
                  "options": [
                    "1.0",
                    "1.1",
                    "1.2"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Advanced",
          "sections": [
            {
              "title": "Event Schema",
              "fields": [
                {
                  "label": "Event Schema",
                  "type": "select",
                  "default": "Cloud Event Schema v1.0",
                  "options": [
                    "Event Grid Schema",
                    "Cloud Event Schema v1.0",
                    "Custom Input Schema"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Tags",
          "sections": [
            {
              "title": "Tags",
              "fields": [
                {
                  "label": "Tags",
                  "type": "table",
                  "columns": [
                    "Name",
                    "Value",
                    "Resource"
                  ],
                  "help": "Name/value pairs to categorize resources and view consolidated billing"
                }
              ]
            }
          ]
        },
        {
          "title": "Review + create",
          "sections": [
            {
              "title": "Basics"
            },
            {
              "title": "Networking"
            },
            {
              "title": "Security"
            },
            {
              "title": "Advanced"
            },
            {
              "title": "Tags"
            }
          ]
        }
      ],
      "submit": "Create",
      "notes": "Footer: Review + create / < Previous / Next : <tab> >; Download a template for automation"
    },
