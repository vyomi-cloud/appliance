    {
      "id": "create-key-vault",
      "kind": "create",
      "title": "Create a key vault",
      "route": "#create/Microsoft.KeyVault",
      "breadcrumbs": [
        "Home",
        "Key vaults",
        "Create a key vault"
      ],
      "captures": [
        "C-forms/06-create-microsoft-keyvault/step-1-expanded"
      ],
      "provenance": "reference",
      "confidence": "medium",
      "steps": [
        {
          "title": "Basics",
          "sections": [
            {
              "title": "Project details",
              "fields": [
                {
                  "label": "Subscription",
                  "type": "select",
                  "required": true,
                  "placeholder": "Select a subscription"
                },
                {
                  "label": "Resource group",
                  "type": "select",
                  "required": true,
                  "actions": [
                    "Create new"
                  ]
                }
              ]
            },
            {
              "title": "Instance details",
              "fields": [
                {
                  "label": "Key vault name",
                  "type": "text",
                  "required": true,
                  "constraints": "3-24 chars; letters, numbers, hyphens; globally unique"
                },
                {
                  "label": "Region",
                  "type": "select",
                  "required": true,
                  "default": "(US) East US"
                },
                {
                  "label": "Pricing tier",
                  "type": "select",
                  "default": "Standard",
                  "options": [
                    "Standard",
                    "Premium"
                  ]
                }
              ]
            },
            {
              "title": "Recovery options",
              "fields": [
                {
                  "label": "Soft-delete",
                  "type": "readonly",
                  "default": "Enabled"
                },
                {
                  "label": "Days to retain deleted vaults",
                  "type": "number",
                  "default": 90,
                  "constraints": "7-90"
                },
                {
                  "label": "Purge protection",
                  "type": "radio",
                  "default": "Disable purge protection (allow key vault and objects to be purged during retention period)",
                  "options": [
                    "Disable purge protection (allow key vault and objects to be purged during retention period)",
                    "Enable purge protection (enforce a mandatory retention period for deleted vaults and vault objects)"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Access configuration",
          "sections": [
            {
              "title": "Configure data plane access for this key vault",
              "fields": [
                {
                  "label": "Permission model",
                  "type": "radio",
                  "default": "Azure role-based access control (recommended)",
                  "options": [
                    "Azure role-based access control (recommended)",
                    "Vault access policy"
                  ]
                }
              ]
            },
            {
              "title": "Resource access",
              "fields": [
                {
                  "label": "Azure Virtual Machines for deployment",
                  "type": "checkbox",
                  "default": false
                },
                {
                  "label": "Azure Resource Manager for template deployment",
                  "type": "checkbox",
                  "default": false
                },
                {
                  "label": "Azure Disk Encryption for volume encryption",
                  "type": "checkbox",
                  "default": false
                }
              ]
            }
          ]
        },
        {
          "title": "Networking",
          "sections": [
            {
              "title": "Network connectivity",
              "fields": [
                {
                  "label": "Enable public access",
                  "type": "checkbox",
                  "default": true
                }
              ]
            },
            {
              "title": "Public Access",
              "fields": [
                {
                  "label": "Allow access from",
                  "type": "radio",
                  "default": "All networks",
                  "options": [
                    "All networks",
                    "Selected networks"
                  ]
                }
              ]
            },
            {
              "title": "Private endpoint",
              "fields": [
                {
                  "label": "Private endpoint",
                  "type": "table",
                  "columns": [
                    "Name",
                    "Subscription",
                    "Resource group",
                    "Region",
                    "Subnet",
                    "Private DNS zone"
                  ],
                  "actions": [
                    "Create a private endpoint"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Tags",
          "sections": [
            {
              "title": "Tags",
              "fields": [
                {
                  "label": "Tags",
                  "type": "table",
                  "columns": [
                    "Name",
                    "Value",
                    "Resource"
                  ],
                  "help": "Name/value pairs to categorize resources and view consolidated billing"
                }
              ]
            }
          ]
        },
        {
          "title": "Review + create",
          "sections": [
            {
              "title": "Basics"
            },
            {
              "title": "Access configuration"
            },
            {
              "title": "Networking"
            },
            {
              "title": "Tags"
            }
          ]
        }
      ],
      "submit": "Create",
      "notes": "Capture shows CreateKeyVaultBlade erroring without a subscription; fields are reference"
