    {
      "id": "create-cosmos-db-account",
      "kind": "create",
      "title": "Create Azure Cosmos DB Account - Azure Cosmos DB for NoSQL",
      "route": "#create/Microsoft.DocumentDB",
      "breadcrumbs": [
        "Home",
        "Azure Cosmos DB",
        "Create an Azure Cosmos DB account"
      ],
      "captures": [
        "C-forms/04-create-microsoft-documentdb/step-1"
      ],
      "provenance": "reference",
      "confidence": "medium",
      "steps": [
        {
          "title": "Basics",
          "sections": [
            {
              "title": "Workload Type",
              "fields": [
                {
                  "label": "Workload Type",
                  "type": "radio",
                  "default": "Development/Testing",
                  "options": [
                    "Learning",
                    "Development/Testing",
                    "Production"
                  ]
                }
              ]
            },
            {
              "title": "Project Details",
              "fields": [
                {
                  "label": "Subscription",
                  "type": "select",
                  "required": true,
                  "placeholder": "Select a subscription"
                },
                {
                  "label": "Resource Group",
                  "type": "select",
                  "required": true,
                  "actions": [
                    "Create new"
                  ]
                }
              ]
            },
            {
              "title": "Instance Details",
              "fields": [
                {
                  "label": "Account Name",
                  "type": "text",
                  "required": true,
                  "constraints": ".documents.azure.com; 3-44 lowercase letters, numbers, hyphens"
                },
                {
                  "label": "Availability Zones",
                  "type": "radio",
                  "default": "Disable",
                  "options": [
                    "Enable",
                    "Disable"
                  ]
                },
                {
                  "label": "Location",
                  "type": "select",
                  "required": true,
                  "default": "(US) East US"
                },
                {
                  "label": "Capacity mode",
                  "type": "radio",
                  "default": "Provisioned throughput",
                  "options": [
                    "Provisioned throughput",
                    "Serverless"
                  ]
                },
                {
                  "label": "Apply Free Tier Discount",
                  "type": "radio",
                  "default": "Do Not Apply",
                  "options": [
                    "Apply",
                    "Do Not Apply"
                  ]
                },
                {
                  "label": "Limit total account throughput",
                  "type": "checkbox",
                  "default": true
                }
              ]
            }
          ]
        },
        {
          "title": "Global Distribution",
          "sections": [
            {
              "title": "Global Distribution",
              "fields": [
                {
                  "label": "Geo-Redundancy",
                  "type": "radio",
                  "default": "Disable",
                  "options": [
                    "Enable",
                    "Disable"
                  ]
                },
                {
                  "label": "Multi-region Writes",
                  "type": "radio",
                  "default": "Disable",
                  "options": [
                    "Enable",
                    "Disable"
                  ]
                },
                {
                  "label": "Availability Zones",
                  "type": "radio",
                  "default": "Disable",
                  "options": [
                    "Enable",
                    "Disable"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Networking",
          "sections": [
            {
              "title": "Network connectivity",
              "fields": [
                {
                  "label": "Connectivity method",
                  "type": "radio",
                  "default": "All networks",
                  "options": [
                    "All networks",
                    "Public endpoint (selected networks)",
                    "Private endpoint"
                  ]
                }
              ]
            },
            {
              "title": "Connection Security Settings",
              "fields": [
                {
                  "label": "Minimum Transport Layer Security Protocol",
                  "type": "select",
                  "default": "TLS 1.2"
                }
              ]
            }
          ]
        },
        {
          "title": "Backup Policy",
          "sections": [
            {
              "title": "Backup Policy",
              "fields": [
                {
                  "label": "Backup policy",
                  "type": "radio",
                  "default": "Periodic",
                  "options": [
                    "Periodic",
                    "Continuous (7 days)",
                    "Continuous (30 days)"
                  ]
                },
                {
                  "label": "Backup interval",
                  "type": "number",
                  "default": 240,
                  "help": "Minutes",
                  "visible_when": "Backup policy = Periodic"
                },
                {
                  "label": "Backup retention",
                  "type": "number",
                  "default": 8,
                  "help": "Hours",
                  "visible_when": "Backup policy = Periodic"
                },
                {
                  "label": "Copies of data retained",
                  "type": "readonly"
                },
                {
                  "label": "Backup storage redundancy",
                  "type": "radio",
                  "default": "Geo-redundant backup storage",
                  "options": [
                    "Geo-redundant backup storage",
                    "Zone-redundant backup storage",
                    "Locally-redundant backup storage"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Encryption",
          "sections": [
            {
              "title": "Data Encryption",
              "fields": [
                {
                  "label": "Data Encryption",
                  "type": "radio",
                  "default": "Service-managed key",
                  "options": [
                    "Service-managed key",
                    "Customer-managed key (CMK)"
                  ]
                }
              ]
            }
          ]
        },
        {
          "title": "Tags",
          "sections": [
            {
              "title": "Tags",
              "fields": [
                {
                  "label": "Tags",
                  "type": "table",
                  "columns": [
                    "Name",
                    "Value",
                    "Resource"
                  ],
                  "help": "Name/value pairs to categorize resources and view consolidated billing"
                }
              ]
            }
          ]
        },
        {
          "title": "Review + create",
          "sections": [
            {
              "title": "Basics"
            },
            {
              "title": "Global Distribution"
            },
            {
              "title": "Networking"
            },
            {
              "title": "Backup Policy"
            },
            {
              "title": "Encryption"
            },
            {
              "title": "Tags"
            }
          ]
        }
      ],
      "submit": "Create",
      "notes": "Footer: Review + create / < Previous / Next : <tab> >; Download a template for automation"
    },
