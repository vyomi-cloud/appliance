          ]
        },
        {
          "title": "Image tag settings",
          "fields": [
            {
              "label": "Image tag mutability",
              "type": "radio",
              "default": "Mutable",
              "options": [
                "Mutable",
                "Immutable"
              ],
              "help": "Choose the tag mutability setting."
            },
            {
              "label": "Mutable tag exclusions",
              "type": "text",
              "actions": [
                "Add filter"
              ],
              "help": "Tags that match these filters will be immutable (can't be overwritten).",
              "constraints": "Letters, numbers, ._*-; max 128 chars, 2 wildcards, up to 5 filters"
            }
          ]
        },
        {
          "title": "Encryption settings",
          "fields": [
            {
              "label": "Encryption configuration",
              "type": "radio",
              "default": "AES-256",
              "options": [
                "AES-256",
                "AWS KMS"
