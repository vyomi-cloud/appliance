      "breadcrumbs": ["Systems Manager", "Parameter Store", "Create parameter"],
      "provenance": "reference",
      "confidence": "medium",
      "submit": "Create parameter",
      "header_actions": ["Cancel", "Create parameter"],
      "sections": [
        {
          "title": "Parameter details",
          "fields": [
            {"label": "Name", "type": "text", "required": true, "placeholder": "/vyomi/app/config", "constraints": "A-z 0-9 and _ . - / only. Up to 15 hierarchy levels; can't start with aws or ssm."},
            {"label": "Description - optional", "type": "textarea"},
            {"label": "Tier", "type": "radio", "default": "Standard", "options": ["Standard", "Advanced", "Intelligent-Tiering"]}
          ]
        },
        {
          "title": "Value",
          "fields": [
            {"label": "Type", "type": "radio", "default": "String", "options": ["String", "StringList", "SecureString"]},
            {"label": "KMS key source", "type": "text", "visible_when": "Type = SecureString", "help": "The key protecting this parameter's value. Encrypted for real through the KMS core."},
            {"label": "Allowed pattern - optional", "type": "text", "placeholder": "^[a-zA-Z0-9]+$"},
            {"label": "Value", "type": "textarea", "required": true}
          ]
        },
        {
          "title": "Tags - optional",
          "fields": [
            {"label": "Tags", "type": "tags"}
          ]
        }
      ]
    },
