      "notes": "Single-page form. Fields below are for Bucket type = General purpose; 'Advanced settings' is collapsed by default.",
      "submit": "Create bucket",
      "header_actions": [
        "Cancel",
        "Create bucket"
      ],
      "sections": [
        {
          "title": "General configuration",
          "fields": [
            {
              "label": "AWS Region",
              "type": "readonly",
              "default": "{current region}",
              "help": "Region from the console region picker"
            },
            {
              "label": "Bucket type",
              "type": "radio",
              "required": true,
              "default": "General purpose",
              "options": [
                "General purpose",
                "Directory"
              ]
            },
            {
              "label": "Bucket namespace",
              "type": "radio",
              "required": true,
              "default": "Global namespace",
              "options": [
                "Global namespace",
                "Account Regional namespace (recommended)"
              ],
              "visible_when": "Bucket type = General purpose"
            },
            {
              "label": "Bucket name",
              "type": "text",
              "required": true,
              "placeholder": "amzn-s3-demo-bucket",
              "constraints": "3-63 chars; a-z, 0-9, '.', '-'; begin and end with a letter or number; globally unique"
            },
            {
              "label": "Copy settings from existing bucket",
              "type": "button",
              "required": false,
              "default": "Choose bucket",
              "help": "Format: s3://bucket/prefix"
            }
          ]
        },
        {
          "title": "Object Ownership",
          "fields": [
            {
              "label": "Object Ownership",
              "type": "radio",
              "required": true,
              "default": "ACLs disabled (recommended)",
              "options": [
                "ACLs disabled (recommended)",
                "ACLs enabled"
              ]
            },
            {
              "label": "Object Ownership",
              "type": "readonly",
              "default": "Bucket owner enforced",
              "visible_when": "Object Ownership = ACLs disabled (recommended)",
              "options": [
                "Bucket owner enforced",
                "Bucket owner preferred",
                "Object writer"
              ]
            }
          ]
        },
        {
          "title": "Block Public Access settings for this bucket",
          "fields": [
            {
              "label": "Block all public access",
              "type": "checkbox",
              "default": true,
              "children": [
                {
                  "label": "Block public access to buckets and objects granted through new access control lists (ACLs)",
                  "type": "checkbox",
                  "default": true
                },
                {
                  "label": "Block public access to buckets and objects granted through any access control lists (ACLs)",
                  "type": "checkbox",
                  "default": true
                },
                {
                  "label": "Block public access to buckets and objects granted through new public bucket or access point policies",
                  "type": "checkbox",
                  "default": true
                },
