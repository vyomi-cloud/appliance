#!/usr/bin/env bash
# vyomi-docker — Docker-substrate launcher for the Free / Lite / Pro tiers.
#
# Runs the Vyomi simulator via `docker compose` using the pull-only
# docker-compose.cloudlite.yml shipped in this package. It NEVER installs or
# touches Multipass / LXD — that's the Max tier (the `vyomi`
# launcher package). Compute (Pro) runs as sibling Docker containers.
#
# Usage:  vyomi up | down | restart | status | logs | update | version
set -euo pipefail

# Help works without Docker or the bundled compose file (used by the brew test).
case "${1:-up}" in
  -h|--help|help)
    echo "vyomi (Docker substrate) — Free/Lite/Pro tiers"
    echo "  vyomi up | down | restart | status | logs | update | version"
    echo "  Runs the simulator via 'docker compose up'; never touches Multipass."
    exit 0
    ;;
esac

# Find the bundled compose file. Works for both the .deb/.rpm layout
# (/usr/bin/vyomi + /usr/share/vyomi-docker/) and the Homebrew layout
# (PREFIX/bin/vyomi + PREFIX/share/vyomi-docker/), via a path relative to
# this script. Override with VYOMI_COMPOSE_FILE.
SELF_DIR="$(cd "$(dirname "$0")" && pwd)"
COMPOSE_FILE="${VYOMI_COMPOSE_FILE:-${VYOMI_BUNDLED_COMPOSE:-}}"
if [ -z "$COMPOSE_FILE" ]; then
  for _c in "/usr/share/vyomi-docker/docker-compose.cloudlite.yml" \
            "$SELF_DIR/../share/vyomi-docker/docker-compose.cloudlite.yml"; do
    if [ -f "$_c" ]; then COMPOSE_FILE="$_c"; break; fi
  done
fi
if [ -z "$COMPOSE_FILE" ] || [ ! -f "$COMPOSE_FILE" ]; then
  echo "vyomi: bundled docker-compose.cloudlite.yml not found (set VYOMI_COMPOSE_FILE)." >&2
  exit 1
fi

# Release images are pinned in the compose file (vyomi/appliance:X.Y.Z), so a
# plain `pull` never moves past the installed package. `vyomi update` fetches
# the latest release's compose file into $VYOMI_HOME; use it whenever it pins a
# newer release than the bundled one (a later package upgrade wins again).
VYOMI_HOME="${VYOMI_HOME:-$HOME/.vyomi}"
VYOMI_REPO="vyomi-cloud/appliance"
pinned_ver() { sed -nE 's#.*vyomi/appliance:([0-9]+\.[0-9]+\.[0-9]+).*#\1#p' "$1" | head -1; }
# The package's own compose file is pinned to the package's release, so its pin is
# the version of this command (the ~/.vyomi cache below can run a newer simulator).
CLI_VERSION="$(pinned_ver "$COMPOSE_FILE")"
VYOMI_FLAVOUR="${VYOMI_FLAVOUR:-vyomi-docker · Free/Lite/Pro}"
VYOMI_BREW_FORMULA="${VYOMI_BREW_FORMULA:-vyomi-docker}"
VYOMI_URL="${VYOMI_URL:-http://localhost:9000}"
latest_release() {   # newest published release (X.Y.Z), or nothing when offline
  curl -fsSL --max-time "${1:-15}" "https://api.github.com/repos/$VYOMI_REPO/releases/latest" 2>/dev/null \
    | sed -nE 's/.*"tag_name": *"v?([0-9]+\.[0-9]+\.[0-9]+)".*/\1/p' | head -1
}
ver_gt() {  # true when $1 is a strictly newer X.Y.Z than $2
  [ -n "$1" ] && [ "$1" != "$2" ] && \
    [ "$(printf '%s\n%s\n' "$1" "${2:-0.0.0}" | sort -t. -k1,1n -k2,2n -k3,3n | tail -1)" = "$1" ]
}
if [ -z "${VYOMI_COMPOSE_FILE:-}" ] && [ -f "$VYOMI_HOME/docker-compose.cloudlite.yml" ] && \
   ver_gt "$(pinned_ver "$VYOMI_HOME/docker-compose.cloudlite.yml")" "$(pinned_ver "$COMPOSE_FILE")"; then
  COMPOSE_FILE="$VYOMI_HOME/docker-compose.cloudlite.yml"
fi
PROJECT="${VYOMI_PROJECT:-vyomi}"

# `vyomi --version`: works without Docker. Shows this command, the simulator that is
# actually running and the release it would start, plus a newer release if there is
# one (a 3 s check; VYOMI_NO_UPDATE_CHECK=1 skips it).
case "${1:-}" in
  -V|--version|version)
    run_ver="$(curl -fs --max-time 2 "$VYOMI_URL/api/runtime/version" 2>/dev/null \
      | sed -nE 's/.*"version": *"([^"]+)".*/\1/p')" || true
    echo "vyomi ${CLI_VERSION:-dev} ($VYOMI_FLAVOUR)"
    if [ -n "$run_ver" ]; then echo "  simulator : v$run_ver running on $VYOMI_URL"
    else echo "  simulator : not running"; fi
    echo "  compose   : v$(pinned_ver "$COMPOSE_FILE") ($COMPOSE_FILE)"
    if [ "${VYOMI_NO_UPDATE_CHECK:-}" != "1" ]; then
      lat="$(latest_release 3)" || true
      if ver_gt "$lat" "$(pinned_ver "$COMPOSE_FILE")" || ver_gt "$lat" "${CLI_VERSION:-0.0.0}"; then
        echo "  latest    : v$lat — run \`vyomi update\`"
      elif [ -n "$lat" ]; then
        echo "  latest    : v$lat (up to date)"
      fi
    fi
    exit 0
    ;;
esac

if ! command -v docker >/dev/null 2>&1; then
  echo "vyomi: Docker is required but was not found on PATH." >&2
  echo "  Install Docker Desktop (macOS/Windows) or Docker Engine (Linux):" >&2
  echo "    https://docs.docker.com/engine/install/" >&2
  exit 1
fi

# Prefer the Compose v2 plugin (`docker compose`); fall back to v1 binary.
if docker compose version >/dev/null 2>&1; then
  DC=(docker compose)
else
  DC=(docker-compose)
fi
dc() { "${DC[@]}" -f "$COMPOSE_FILE" -p "$PROJECT" "$@"; }

# Wave 2 — stream the heavy backends (MinIO, Vault, MySQL, DynamoDB, NATS,
# ElasticMQ, Azurite, Pub/Sub, Firestore) in the BACKGROUND, detached so it
# survives this shell exiting. They live behind the compose `full` profile, so
# Wave 1's plain `up -d` skips them; this `--profile full up -d` pulls any
# missing images (first run) then starts them. The console is already usable
# from Wave 1 — the appliance's readiness strip (/api/runtime/readiness) flips
# each backend green as it comes up, matching the Multipass launcher's
# progressive-startup UX. Log to a tempfile so a failed pull is diagnosable.
wave2_full_bg() {
  ( nohup "${DC[@]}" -f "$COMPOSE_FILE" -p "$PROJECT" --profile full up -d \
      </dev/null >"${TMPDIR:-/tmp}/vyomi-wave2.log" 2>&1 & )
}

# Move COMPOSE_FILE to the latest GitHub release when it is newer: download
# that release's tarball, check it against SHA256SUMS, and keep its (already
# pinned) compose file in $VYOMI_HOME. Network failures fall back to the
# current version.
# Upgrade this command itself first when Homebrew installed it, then re-run the
# update with the new one (so a fix to `vyomi update` reaches you in the same run).
# .deb/.rpm installs get the download link. VYOMI_NO_SELF_UPDATE=1 skips it.
self_update() {
  local latest="$1"
  [ "${VYOMI_SELF_UPDATED:-}" = "1" ] || [ "${VYOMI_NO_SELF_UPDATE:-}" = "1" ] && return 0
  ver_gt "$latest" "${CLI_VERSION:-0.0.0}" || return 0
  local real; real="$(cd "$SELF_DIR" && pwd -P)"
  if command -v brew >/dev/null 2>&1 && { [ "$SELF_DIR" = "$(brew --prefix 2>/dev/null)/bin" ] || case "$real" in */Cellar/*) true ;; *) false ;; esac; }; then
    echo "==> Updating the vyomi command ${CLI_VERSION:-?} -> $latest (Homebrew)"
    if brew update --quiet >/dev/null 2>&1 && brew upgrade "vyomi-cloud/tap/$VYOMI_BREW_FORMULA"; then
      export VYOMI_SELF_UPDATED=1
      exec "$SELF_DIR/vyomi" update
    fi
    echo "vyomi: couldn't upgrade the vyomi command; updating the simulator anyway." >&2
    echo "    Upgrade it yourself: brew update && brew trust vyomi-cloud/tap && brew upgrade $VYOMI_BREW_FORMULA" >&2
  else
    echo "    The vyomi command is ${CLI_VERSION:-?}; the $latest package is at" >&2
    echo "    https://github.com/$VYOMI_REPO/releases/tag/v$latest (the simulator updates now either way)." >&2
  fi
}

fetch_latest_release() {
  local cur latest tmp base tgz want got
  cur="$(pinned_ver "$COMPOSE_FILE")"
  latest="$(latest_release 15)" || true
  self_update "$latest"
  if [ -z "$latest" ]; then
    echo "vyomi: couldn't reach GitHub to check for a new release; updating ${cur:-current} images only." >&2
    return 0
  fi
  if ! ver_gt "$latest" "$cur"; then
    echo "==> Vyomi ${cur:-?} is the latest release."
    return 0
  fi
  echo "==> Updating Vyomi ${cur:-?} -> $latest"
  tmp="$(mktemp -d)"; base="https://github.com/$VYOMI_REPO/releases/download/v$latest"
  # The release tarball is vyomi-X.tar.gz (cloud-learn-X.tar.gz before v3.0.33).
  name=vyomi; tgz="$name-$latest.tar.gz"
  if ! curl -fsSL --max-time 300 -o "$tmp/$tgz" "$base/$tgz"; then
    name=cloud-learn; tgz="$name-$latest.tar.gz"
    curl -fsSL --max-time 300 -o "$tmp/$tgz" "$base/$tgz" || tgz=""
  fi
  if [ -z "$tgz" ] || ! curl -fsSL --max-time 30 -o "$tmp/SHA256SUMS" "$base/SHA256SUMS"; then
    echo "vyomi: download of $latest failed; staying on ${cur:-current}." >&2
    rm -rf "$tmp"; return 0
  fi
  want="$(awk -v f="$tgz" '{n=$2; sub(/^\*/,"",n); sub(/.*\//,"",n)} n==f {print $1}' "$tmp/SHA256SUMS")"
  if command -v sha256sum >/dev/null 2>&1; then got="$(sha256sum "$tmp/$tgz" | awk '{print $1}')"
  else got="$(shasum -a 256 "$tmp/$tgz" | awk '{print $1}')"; fi
  if [ -z "$want" ] || [ "$want" != "$got" ]; then
    echo "vyomi: checksum mismatch for $tgz; staying on ${cur:-current}." >&2
    rm -rf "$tmp"; return 1
  fi
  tar -xzf "$tmp/$tgz" -C "$tmp" "$name-$latest/docker-compose.cloudlite.yml"
  if [ "$(pinned_ver "$tmp/$name-$latest/docker-compose.cloudlite.yml")" != "$latest" ]; then
    echo "vyomi: release $latest compose file isn't pinned to $latest; staying on ${cur:-current}." >&2
    rm -rf "$tmp"; return 1
  fi
  mkdir -p "$VYOMI_HOME"
  mv "$tmp/$name-$latest/docker-compose.cloudlite.yml" "$VYOMI_HOME/docker-compose.cloudlite.yml"
  rm -rf "$tmp"
  COMPOSE_FILE="$VYOMI_HOME/docker-compose.cloudlite.yml"
}


# ── Launch view: dot-matrix banner + live steps (cosmetic, honest) ─────────────
# Only on an interactive terminal; plain lines when piped, in CI, with NO_COLOR or
# VYOMI_NO_BANNER=1. Every step reports what actually happened and how long it took.
# Same view as scripts/cloud-learn and cmd/vyomi (tests/launcher/test_launch_view_consistency.py).
_tty=0; [ -t 1 ] && [ -z "${NO_COLOR:-}" ] && [ "${VYOMI_NO_BANNER:-}" != "1" ] && [ "${CI:-}" = "" ] && _tty=1
case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in *UTF-8*|*utf8*|*UTF8*) _utf=1 ;; *) _utf=0 ;; esac
if [ "$_tty" = 1 ]; then _c=$'\033[36m'; _d=$'\033[38;5;236m'; _g=$'\033[32m'; _y=$'\033[33m'; _r=$'\033[31m'; _b=$'\033[1m'; _z=$'\033[0m'
else _c=""; _d=""; _g=""; _y=""; _r=""; _b=""; _z=""; fi
if [ "$_utf" = 1 ]; then _on="●"; _off="·"; _ok="✓"; _bad="✗"; _run="▸"; else _on="#"; _off="."; _ok="ok"; _bad="!!"; _run=">"; fi

banner() {
  [ "$_tty" = 1 ] || return 0
  # LAUNCH-VIEW-MATRIX (keep identical across launchers)
  local rows=(
    "10001 10001 01110 10001 111"
    "10001 10001 10001 11011 010"
    "10001 01010 10001 10101 010"
    "10001 00100 10001 10101 010"
    "01010 00100 10001 10001 010"
    "01010 00100 10001 10001 010"
    "00100 00100 01110 10001 111"
  )
  echo
  local row ch i line
  for row in "${rows[@]}"; do
    line="  "
    for ((i = 0; i < ${#row}; i++)); do
      ch="${row:i:1}"
      case "$ch" in 1) line+="${_c}${_on}${_z} " ;; 0) line+="${_d}${_off}${_z} " ;; " ") line+="  " ;; esac
    done
    printf '%s\n' "$line"
  done
  printf '\n  %slocal AWS · GCP · Azure — no cloud bill%s   %s%s%s\n\n' "$_b" "$_z" "$_d" "${1:-}" "$_z"
}

_t0=$(date +%s)
_since() { echo "$(( $(date +%s) - _t0 ))s"; }
step_ok()  { printf '  %s%s%s %-10s %s %s(%s)%s\n' "$_g" "$_ok" "$_z" "$1" "$2" "$_d" "$(_since)" "$_z"; }
step_bad() { printf '  %s%s%s %-10s %s\n' "$_r" "$_bad" "$_z" "$1" "$2" >&2; }
step_run() { if [ "$_tty" = 1 ]; then printf '\r\033[K  %s%s%s %-10s %s' "$_y" "$_run" "$_z" "$1" "$2"; fi; }
step_end() { if [ "$_tty" = 1 ]; then printf '\r\033[K'; fi; }

# Wait for the console, then show the backends coming up (they keep starting in the
# background after we return; the console's readiness strip shows the rest).
wait_ready() {
  local i body ready total pct
  for ((i = 0; i < 120; i++)); do
    if curl -fs --max-time 2 "$VYOMI_URL/api/runtime/readiness" >/dev/null 2>&1; then break; fi
    step_run "console" "starting the simulator… ${i}s"; sleep 1
  done
  step_end
  if ! curl -fs --max-time 2 "$VYOMI_URL/api/runtime/readiness" >/dev/null 2>&1; then
    step_bad "console" "not answering on $VYOMI_URL yet — check \`vyomi logs simulator\`"; return 1
  fi
  step_ok "console" "$VYOMI_URL"
  for ((i = 0; i < 90; i++)); do
    body="$(curl -fs --max-time 2 "$VYOMI_URL/api/runtime/readiness" 2>/dev/null || true)"
    ready="$(printf '%s' "$body" | sed -n 's/.*"ready_count":\([0-9]*\).*/\1/p')"
    total="$(printf '%s' "$body" | sed -n 's/.*"total_count":\([0-9]*\).*/\1/p')"
    pct="$(printf '%s' "$body" | sed -n 's/.*"overall_pct":\([0-9]*\).*/\1/p')"
    [ -n "$total" ] || break
    if [ "$ready" = "$total" ]; then step_end; step_ok "backends" "${total}/${total} ready (S3 · KMS · SQL · NoSQL · queues · Pub/Sub · Blob)"; return 0; fi
    step_run "backends" "${ready}/${total} ready (${pct}%) — pulling and starting in the background"
    [ "$_tty" = 1 ] || break          # non-interactive: don't hold the shell for the heavy backends
    sleep 2
  done
  step_end
  [ -n "${total:-}" ] && step_ok "backends" "${ready:-0}/${total} ready; the rest keep starting in the background"
  return 0
}

launch() {   # $1 = label for the banner
  banner "$1"
  if docker info >/dev/null 2>&1; then step_ok "docker" "engine reachable ($(docker --version 2>/dev/null | sed 's/^Docker version //;s/,.*//'))"
  else step_bad "docker" "engine not reachable — start Docker Desktop (macOS/Windows) or dockerd (Linux)"; exit 1; fi
  step_run "images" "pulling $(pinned_ver "$COMPOSE_FILE" || true)…"
  local log; log="$(mktemp)"
  if ! dc up -d --quiet-pull >"$log" 2>&1 && ! dc up -d >"$log" 2>&1; then
    step_end; step_bad "start" "docker compose up failed:"; tail -n 15 "$log" >&2; rm -f "$log"; exit 1
  fi
  rm -f "$log"; step_end
  step_ok "start" "simulator v$(pinned_ver "$COMPOSE_FILE") + core services"
  wave2_full_bg
  step_ok "downloads" "heavy backends (S3, KMS, SQL, NoSQL, queues) downloading in the background"
  wait_ready || true
  # LAUNCH-VIEW-READY (keep identical across launchers)
  printf '\n  %sReady.%s Open %s%s%s   ·   SDK/CLI: point --endpoint-url at %s\n' "$_b" "$_z" "$_c" "$VYOMI_URL" "$_z" "$VYOMI_URL"
  printf '  %sPro tier: launch an EC2 instance in the console, then ssh ubuntu@<ip>.%s\n\n' "$_d" "$_z"
}

case "${1:-up}" in
  up|start)
    # Wave 1 — base only (simulator + required deps): the console is reachable the
    # moment the simulator is healthy. Wave 2 — the heavy backends download + start
    # in the background (launch() runs both and shows each step live).
    launch "v$(pinned_ver "$COMPOSE_FILE" || echo dev)"
    ;;
  down|stop)       dc --profile full down ;;
  restart)         dc --profile full down; dc up -d; wave2_full_bg ;;
  status|ps)       dc --profile full ps ;;
  logs)            shift; dc --profile full logs "$@" ;;
  update|upgrade)
    fetch_latest_release
    dc --profile full pull && dc up -d --remove-orphans && wave2_full_bg
    banner "updated to v$(pinned_ver "$COMPOSE_FILE")"
    wait_ready || true
    ;;
  doctor)
    # Environment report (was falling through to `docker compose doctor`,
    # which isn't a compose command, so it printed compose's usage text).
    echo "vyomi (Docker substrate) doctor"
    echo "  compose file : $COMPOSE_FILE"
    echo "  version      : $(pinned_ver "$COMPOSE_FILE")"
    echo "  docker       : $(docker --version 2>/dev/null || echo missing)"
    echo "  compose      : $("${DC[@]}" version --short 2>/dev/null || "${DC[@]}" version 2>/dev/null | head -1 || echo missing)"
    if docker info >/dev/null 2>&1; then echo "  engine       : running"; else echo "  engine       : NOT reachable (start Docker Desktop / dockerd)"; fi
    echo "  containers   :"; dc --profile full ps --format '    {{.Name}}  {{.Status}}' 2>/dev/null || echo "    (none)"
    ;;
  *)               dc "$@" ;;
esac
