{
  "_comment": "Hourly conformance manifest. The agent ADDS suites here as it writes new test beds; never delete or weaken one to make the page green. kind: ui | sdk-java | sdk-go | sdk-python | cli | api | core. {ENDPOINT} and {RELAY} are substituted at run time.",
  "suites": [
    {"id": "offline-ui-crawl", "target": "offline", "cloud": "all", "kind": "ui", "cmd": "TARGET=offline OUT=tests/conformance/hourly/out/ui-offline.json node tests/conformance/hourly/ui_crawler.mjs", "timeout": 1500},
    {"id": "offline-console-actions", "target": "offline", "cloud": "all", "kind": "api", "cmd": "VYOMI_BASE_URL={ENDPOINT} VYOMI_CONFORMANCE_REPORT=tests/conformance/console_actions/REPORT.md python3 -m pytest tests/conformance/console_actions/ -q --tb=line", "timeout": 1200},
    {"id": "offline-api-ec2-instance-detail", "target": "offline", "cloud": "aws", "kind": "api", "cmd": "VYOMI_BASE_URL={ENDPOINT} python3 tests/conformance/test_ec2_instance_detail_api.py", "timeout": 120},
    {"id": "offline-api-s3-bucket-creation-date", "target": "offline", "cloud": "aws", "kind": "api", "cmd": "VYOMI_BASE_URL={ENDPOINT} python3 tests/conformance/test_s3_bucket_creation_date_api.py", "timeout": 120},
    {"id": "offline-api-gcp-eventarc-trigger-defaults", "target": "offline", "cloud": "gcp", "kind": "api", "cmd": "VYOMI_BASE_URL={ENDPOINT} python3 tests/conformance/test_gcp_eventarc_trigger_defaults_api.py", "timeout": 120},
    {"id": "offline-api-ec2-default-public-ip", "target": "offline", "cloud": "aws", "kind": "api", "cmd": "VYOMI_BASE_URL={ENDPOINT} python3 tests/conformance/test_ec2_default_public_ip_api.py", "timeout": 120},
    {"id": "offline-sdk-python-aws", "target": "offline", "cloud": "aws", "kind": "sdk-python", "cmd": "python3 tests/conformance/run_conformance.py --endpoint {ENDPOINT}", "timeout": 600},
    {"id": "offline-sdk-go-aws", "target": "offline", "cloud": "aws", "kind": "sdk-go", "cwd": "tests/conformance/aws-sdk-go", "cmd": "ENDPOINT={ENDPOINT} GOFLAGS=-mod=mod go run .", "timeout": 600},
    {"id": "offline-sdk-go-gcp", "target": "offline", "cloud": "gcp", "kind": "sdk-go", "cwd": "tests/conformance/gcp-sdk-go", "cmd": "STORAGE_EMULATOR_HOST={ENDPOINT_HOSTPORT} GOFLAGS=-mod=mod go run .", "timeout": 600},
    {"id": "offline-sdk-go-azure", "target": "offline", "cloud": "azure", "kind": "sdk-go", "cwd": "tests/conformance/azure-sdk-go", "cmd": "ENDPOINT={ENDPOINT} GOFLAGS=-mod=mod go run .", "timeout": 600},
    {"id": "offline-sdk-java-aws", "target": "offline", "cloud": "aws", "kind": "sdk-java", "cwd": "tests/conformance/aws-sdk-java", "cmd": "ENDPOINT={ENDPOINT} mvn -q -B compile exec:java", "timeout": 900},
    {"id": "offline-sdk-java-gcp", "target": "offline", "cloud": "gcp", "kind": "sdk-java", "cwd": "tests/conformance/gcp-sdk-java", "cmd": "ENDPOINT={ENDPOINT} mvn -q -B compile exec:java", "timeout": 900},
    {"id": "offline-sdk-java-azure", "target": "offline", "cloud": "azure", "kind": "sdk-java", "cwd": "tests/conformance/azure-sdk-java", "cmd": "ENDPOINT={ENDPOINT} mvn -q -B compile exec:java", "timeout": 900},
    {"id": "offline-cost-savings", "target": "offline", "cloud": "all", "kind": "api", "cmd": "ENDPOINT={ENDPOINT} python3 tests/conformance/hourly/savings_check.py", "timeout": 300},
    {"id": "offline-cli-aws", "target": "offline", "cloud": "aws", "kind": "cli", "cmd": "ENDPOINT={ENDPOINT} bash tests/cli/aws-cli-smoke.sh", "timeout": 300},
    {"id": "offline-cli-gcp", "target": "offline", "cloud": "gcp", "kind": "cli", "cmd": "ENDPOINT={ENDPOINT} bash tests/cli/gcp-cli-smoke.sh", "timeout": 300},
