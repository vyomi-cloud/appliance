    {"id": "offline-ui-core", "target": "offline", "cloud": "all", "kind": "ui", "cmd": "VYOMI_BASE_URL={ENDPOINT} node tests/conformance/ui/offline-console-core.mjs", "timeout": 600},

    {"id": "nano-ui-crawl", "target": "nano", "cloud": "all", "kind": "ui", "cmd": "TARGET=nano NANO_DIR=wasm OUT=tests/conformance/hourly/out/ui-nano.json node tests/conformance/hourly/ui_crawler.mjs", "timeout": 1800},
    {"id": "nano-cores", "target": "nano", "cloud": "all", "kind": "core", "cmd": "PYTHONPATH=wasm/core python3 -m pytest tests/conformance/test_*_core.py -q --tb=line", "timeout": 900},
